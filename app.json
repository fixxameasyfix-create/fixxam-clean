{
  "expo": {
    "name": "Fixxam",
    "slug": "fixxam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ui-images/icon.png",
    "scheme": "fixxam",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "package": "com.fixxam.app",
      "versionCode": 1,
      "googleServicesFile": "./android/app/google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",

      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FFFFFF",
          "defaultChannel": "fixxam-default",
          "sounds": []
        }
      ],

      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],

      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Fixxam to access your location so workers can find you accurately."
        }
      ],

      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Fixxam to access your photos so you can upload repair images.",
          "cameraPermission": "Allow Fixxam to use your camera to capture repair photos."
        }
      ],

      "@react-native-community/datetimepicker"
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "2b30c0e8-95fe-492e-b7df-6476f22e1f0c"
      }
    }
  }
}