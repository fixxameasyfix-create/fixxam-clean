/*
 * ============================================================
 * AUTO-GENERATED FIRESTORE RULES
 *
 * DO NOT EDIT THIS FILE DIRECTLY.
 *
 * Edit files inside:
 * firestore/rules/
 *
 * Then run:
 * npm run rules:build
 * ============================================================
 */

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ============================================================
       SOURCE: firestore/rules/01-core.rules
    ============================================================ */

    /* ============================================================
       01-CORE.RULES
    
       Shared helpers used by other Firestore rule files.
    
       Main areas:
       - Authentication
       - User roles
       - Worker profiles
       - Calls
       - Worker contacts
       - Bookings
       - Market orders
       - Shop requests
       - Market chats
    ============================================================ */
    
    
    /* ============================================================
       GENERAL HELPERS
    ============================================================ */
    
    function signedIn() {
      return request.auth != null;
    }
    
    
    function isOwner(uid) {
      return signedIn()
        && request.auth.uid == uid;
    }
    
    
    function workerProfileExists(workerId) {
      return exists(
        /databases/$(database)/documents/workerPublicProfiles/$(workerId)
      );
    }
    
    
    function validUserRoleState(data) {
      return data.roles is list
        && data.roles.size() >= 1
        && data.roles.size() <= 2
        && data.roles.hasOnly([
          "customer",
          "worker"
        ])
        && data.activeRole is string
        && data.activeRole in data.roles;
    }
    
    
    /* ============================================================
       CALL HELPERS
    ============================================================ */
    
    function validCallSnapshot(value) {
      return value == null
        || (
          value is map
    
          && value.keys().hasOnly([
            "name",
            "image",
            "service"
          ])
    
          && value["name"] is string
          && value["name"].size() > 0
          && value["name"].size() <= 120
    
          && value["image"] is string
          && value["image"].size() <= 2048
    
          && (
            value["image"] == ""
            || value["image"].matches("^https://.*")
          )
    
          && value["service"] is string
          && value["service"].size() <= 160
        );
    }
    
    
    function isCallParticipant(data) {
      return signedIn()
        && (
          data.callerId == request.auth.uid
          || data.calleeId == request.auth.uid
        );
    }
    
    
    /* ============================================================
       WORKER CALL CONTACT HELPERS
    
       Structure:
    
       workerContacts/{workerId}/customers/{customerId}
    
       A worker must already have the customer in contacts
       before making a repeat call.
    ============================================================ */
    
    function workerContactExists(
      workerId,
      customerId
    ) {
      return exists(
        /databases/$(database)/documents/workerContacts/$(workerId)/customers/$(customerId)
      );
    }
    
    
    function isWorkerCallContact(
      workerId,
      customerId
    ) {
      return signedIn()
        && request.auth.uid == workerId
        && workerContactExists(
          workerId,
          customerId
        );
    }
    
    
    /* ============================================================
       BOOKING HELPERS
    ============================================================ */
    
    function bookingExists(
      bookingId
    ) {
      return exists(
        /databases/$(database)/documents/bookings/$(bookingId)
      );
    }
    
    
    function currentBooking(
      bookingId
    ) {
      return get(
        /databases/$(database)/documents/bookings/$(bookingId)
      ).data;
    }
    
    
    function isBookingCustomer(
      bookingId
    ) {
      return signedIn()
        && bookingExists(bookingId)
        && currentBooking(bookingId).customerId
          == request.auth.uid;
    }
    
    
    function isBookingWorker(
      bookingId
    ) {
      return signedIn()
        && bookingExists(bookingId)
        && currentBooking(bookingId).workerId
          == request.auth.uid;
    }
    
    
    /* ============================================================
       BOOKING OFFER HELPERS
    ============================================================ */
    
    function validOfferAmount(
      value
    ) {
      return value is number
        && value > 0
        && value <= 100000000;
    }
    
    
    function validNullableOfferAmount(
      value
    ) {
      return value == null
        || validOfferAmount(value);
    }
    
    
    function validOfferMessage(
      value
    ) {
      return value == null
        || (
          value is string
          && value.size() <= 300
        );
    }
    
    
    function validOfferRound(
      value
    ) {
      return value is int
        && value >= 0;
    }
    
    
    function bookingPartiesUnchanged() {
      return request.resource.data.customerId
        == resource.data.customerId
    
        && request.resource.data.workerId
          == resource.data.workerId;
    }
    
    
    function bookingChangedKeys() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys();
    }
    
    
    function bookingChangedOnly(
      keys
    ) {
      return bookingChangedKeys()
        .hasOnly(keys);
    }
    
    
    function bookingChangedAny(
      keys
    ) {
      return bookingChangedKeys()
        .hasAny(keys);
    }
    
    
    /* ============================================================
       MARKET ORDER HELPERS
    ============================================================ */
    
    function marketOrderExists(
      orderId
    ) {
      return exists(
        /databases/$(database)/documents/orders/$(orderId)
      );
    }
    
    
    function currentMarketOrder(
      orderId
    ) {
      return get(
        /databases/$(database)/documents/orders/$(orderId)
      ).data;
    }
    
    
    function isMarketOrderCustomer(
      orderId
    ) {
      return signedIn()
        && marketOrderExists(orderId)
        && currentMarketOrder(orderId).customerId
          == request.auth.uid;
    }
    
    
    function isMarketOrderWorker(
      orderId
    ) {
      return signedIn()
        && marketOrderExists(orderId)
        && currentMarketOrder(orderId).workerId
          == request.auth.uid;
    }
    
    
    function isMarketOrderSeller(
      orderId
    ) {
      return signedIn()
        && marketOrderExists(orderId)
        && currentMarketOrder(orderId).sellerId
          == request.auth.uid;
    }
    
    
    function isMarketOrderParticipant(
      orderId
    ) {
      return isMarketOrderCustomer(orderId)
        || isMarketOrderWorker(orderId)
        || isMarketOrderSeller(orderId);
    }
    
    
    /* ============================================================
       WORKER -> CUSTOMER MARKET CALL
    ============================================================ */
    
    function validWorkerMarketCallCreate() {
      return signedIn()
    
        && request.resource.data.keys().hasAll([
          "callerId",
          "callerRole",
          "calleeId",
          "calleeRole",
          "orderId",
          "callerSnapshot",
          "calleeSnapshot",
          "status",
          "createdAt",
          "acceptedAt",
          "connectedAt",
          "endedAt",
          "endedBy"
        ])
    
        && request.resource.data.keys().hasOnly([
          "callerId",
          "callerRole",
          "calleeId",
          "calleeRole",
          "orderId",
          "callerSnapshot",
          "calleeSnapshot",
          "status",
          "createdAt",
          "acceptedAt",
          "connectedAt",
          "endedAt",
          "endedBy"
        ])
    
        /* --------------------------------------------------------
           CALLER
        -------------------------------------------------------- */
    
        && request.resource.data.callerId
          == request.auth.uid
    
        && request.resource.data.callerRole
          == "worker"
    
        /* --------------------------------------------------------
           CALLEE
        -------------------------------------------------------- */
    
        && request.resource.data.calleeId
          is string
    
        && request.resource.data.calleeId.size()
          > 0
    
        && request.resource.data.calleeId.size()
          <= 128
    
        && request.resource.data.calleeId
          != request.auth.uid
    
        && request.resource.data.calleeRole
          == "customer"
    
        /* --------------------------------------------------------
           ORDER
        -------------------------------------------------------- */
    
        && request.resource.data.orderId
          is string
    
        && request.resource.data.orderId.size()
          > 0
    
        && request.resource.data.orderId.size()
          <= 128
    
        && marketOrderExists(
          request.resource.data.orderId
        )
    
        && currentMarketOrder(
          request.resource.data.orderId
        ).workerId
          == request.auth.uid
    
        && currentMarketOrder(
          request.resource.data.orderId
        ).customerId
          == request.resource.data.calleeId
    
        /* --------------------------------------------------------
           CALLER SNAPSHOT
        -------------------------------------------------------- */
    
        && request.resource.data.callerSnapshot
          != null
    
        && validCallSnapshot(
          request.resource.data.callerSnapshot
        )
    
        /* --------------------------------------------------------
           CALLEE SNAPSHOT
        -------------------------------------------------------- */
    
        && request.resource.data.calleeSnapshot
          != null
    
        && validCallSnapshot(
          request.resource.data.calleeSnapshot
        )
    
        /* --------------------------------------------------------
           INITIAL CALL STATE
        -------------------------------------------------------- */
    
        && request.resource.data.status
          == "ringing"
    
        && request.resource.data.createdAt
          == request.time
    
        && request.resource.data.acceptedAt
          == null
    
        && request.resource.data.connectedAt
          == null
    
        && request.resource.data.endedAt
          == null
    
        && request.resource.data.endedBy
          == null;
    }
    
    
    /* ============================================================
       SHOP REQUEST HELPERS
    ============================================================ */
    
    function shopRequestExists(
      shopRequestId
    ) {
      return exists(
        /databases/$(database)/documents/shopRequests/$(shopRequestId)
      );
    }
    
    
    function currentShopRequest(
      shopRequestId
    ) {
      return get(
        /databases/$(database)/documents/shopRequests/$(shopRequestId)
      ).data;
    }
    
    
    /* ============================================================
       WORKER -> CUSTOMER SHOP REQUEST CALL
    ============================================================ */
    
    function validWorkerShopRequestCallCreate() {
      return signedIn()
    
        /* ========================================================
           EXACT CALL DOCUMENT SCHEMA
        ======================================================== */
    
        && request.resource.data.keys().hasAll([
          "callerId",
          "callerRole",
          "calleeId",
          "calleeRole",
          "shopRequestId",
          "callerSnapshot",
          "calleeSnapshot",
          "status",
          "createdAt",
          "acceptedAt",
          "connectedAt",
          "endedAt",
          "endedBy"
        ])
    
        && request.resource.data.keys().hasOnly([
          "callerId",
          "callerRole",
          "calleeId",
          "calleeRole",
          "shopRequestId",
          "callerSnapshot",
          "calleeSnapshot",
          "status",
          "createdAt",
          "acceptedAt",
          "connectedAt",
          "endedAt",
          "endedBy"
        ])
    
        /* ========================================================
           CALLER — AUTHENTICATED WORKER
        ======================================================== */
    
        && request.resource.data.callerId
          == request.auth.uid
    
        && request.resource.data.callerRole
          == "worker"
    
        /* ========================================================
           CALLEE — REQUEST CUSTOMER
        ======================================================== */
    
        && request.resource.data.calleeId
          is string
    
        && request.resource.data.calleeId.size()
          > 0
    
        && request.resource.data.calleeId.size()
          <= 128
    
        && request.resource.data.calleeId
          != request.auth.uid
    
        && request.resource.data.calleeRole
          == "customer"
    
        /* ========================================================
           SHOP REQUEST ID
        ======================================================== */
    
        && request.resource.data.shopRequestId
          is string
    
        && request.resource.data.shopRequestId.size()
          > 0
    
        && request.resource.data.shopRequestId.size()
          <= 128
    
        /* ========================================================
           REQUEST MUST EXIST
        ======================================================== */
    
        && shopRequestExists(
          request.resource.data.shopRequestId
        )
    
        /* ========================================================
           WORKER MUST OWN REQUEST
        ======================================================== */
    
        && currentShopRequest(
          request.resource.data.shopRequestId
        ).workerId
          == request.auth.uid
    
        /* ========================================================
           CALLEE MUST BE REQUEST CUSTOMER
        ======================================================== */
    
        && currentShopRequest(
          request.resource.data.shopRequestId
        ).customerId
          == request.resource.data.calleeId
    
        /* ========================================================
           REQUEST MUST BE ACTIVE
        ======================================================== */
    
        && currentShopRequest(
          request.resource.data.shopRequestId
        ).status in [
          "pending",
          "accepted"
        ]
    
        /* ========================================================
           CALLER SNAPSHOT
        ======================================================== */
    
        && request.resource.data.callerSnapshot
          != null
    
        && validCallSnapshot(
          request.resource.data.callerSnapshot
        )
    
        /* ========================================================
           CALLEE SNAPSHOT
        ======================================================== */
    
        && request.resource.data.calleeSnapshot
          != null
    
        && validCallSnapshot(
          request.resource.data.calleeSnapshot
        )
    
        /* ========================================================
           INITIAL CALL STATE
        ======================================================== */
    
        && request.resource.data.status
          == "ringing"
    
        && request.resource.data.createdAt
          == request.time
    
        && request.resource.data.acceptedAt
          == null
    
        && request.resource.data.connectedAt
          == null
    
        && request.resource.data.endedAt
          == null
    
        && request.resource.data.endedBy
          == null;
    }
    
    
    /* ============================================================
       MARKET CHAT HELPERS
    ============================================================ */
    
    function marketChatExists(
      chatId
    ) {
      return exists(
        /databases/$(database)/documents/marketChats/$(chatId)
      );
    }
    
    
    function currentMarketChat(
      chatId
    ) {
      return get(
        /databases/$(database)/documents/marketChats/$(chatId)
      ).data;
    }
    
    
    function isMarketChatParticipant(
      chatId
    ) {
      return signedIn()
        && marketChatExists(chatId)
        && (
          (
            "customerId" in currentMarketChat(chatId)
    
            && currentMarketChat(chatId).customerId
              == request.auth.uid
          )
    
          ||
    
          (
            "workerId" in currentMarketChat(chatId)
    
            && currentMarketChat(chatId).workerId
              == request.auth.uid
          )
    
          ||
    
          (
            "sellerId" in currentMarketChat(chatId)
    
            && currentMarketChat(chatId).sellerId
              == request.auth.uid
          )
        );
    }
    
    
    function isMarketChatOrderParticipant(
      chatId
    ) {
      return signedIn()
        && marketOrderExists(chatId)
        && isMarketOrderParticipant(chatId);
    }

    /* ============================================================
       SOURCE: firestore/rules/02-users.rules
    ============================================================ */

    /* ============================================================
       USERS
    ============================================================ */
    
    match /users/{userId} {
    
      /* ----------------------------------------------------------
         CREATE USER PROFILE
    
         A newly authenticated user may create only their own
         customer or worker profile.
    
         CUSTOMER:
           - authenticated owner
           - valid role state
           - customer role
           - customer activeRole
    
         WORKER:
           - authenticated owner
           - valid role state
           - worker role
           - worker activeRole
      ---------------------------------------------------------- */
    
      allow create:
        if isOwner(userId)
        && validUserRoleState(
          request.resource.data
        )
        && (
          (
            request.resource.data.roles.hasAny([
              "customer"
            ])
            && request.resource.data.activeRole
              == "customer"
          )
          ||
          (
            request.resource.data.roles.hasAny([
              "worker"
            ])
            && request.resource.data.activeRole
              == "worker"
          )
        );
    
    
      /* ----------------------------------------------------------
         READ
      ---------------------------------------------------------- */
    
      allow read:
        if isOwner(userId);
    
    
      /* ----------------------------------------------------------
         UPDATE
      ---------------------------------------------------------- */
    
      allow update:
        if isOwner(userId)
        && validUserRoleState(
          request.resource.data
        );
    
    
      /* ----------------------------------------------------------
         DELETE
      ---------------------------------------------------------- */
    
      allow delete:
        if false;
    
    
      /* ----------------------------------------------------------
         USER NOTIFICATIONS
      ---------------------------------------------------------- */
    
      match /notifications/{notificationId} {
    
        allow read:
          if signedIn()
          && request.auth.uid == userId;
    
        allow create:
          if false;
    
        allow update:
          if signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(
            resource.data
          ).affectedKeys().hasOnly([
            "read"
          ])
          && request.resource.data.read
            is bool;
    
        allow delete:
          if false;
      }
    
    
      /* ----------------------------------------------------------
         PAYMENT METHODS
      ---------------------------------------------------------- */
    
      match /paymentMethods/{methodId} {
    
        allow read:
          if isOwner(userId);
    
        allow create, update, delete:
          if false;
      }
    }
    
    
    /* ============================================================
       CUSTOMER WALLET
    ============================================================ */
    
    match /wallets/{userId} {
    
      allow read:
        if isOwner(userId);
    
      allow create, update, delete:
        if false;
    
    
      match /transactions/{transactionId} {
    
        allow read:
          if isOwner(userId);
    
        allow create, update, delete:
          if false;
      }
    }
    
    
    /* ============================================================
       WORKER PUBLIC PROFILES
    ============================================================ */
    
    match /workerPublicProfiles/{workerId} {
    
      allow read:
        if true;
    
      allow create:
        if isOwner(workerId);
    
      allow update:
        if isOwner(workerId);
    
      allow delete:
        if false;
    }
    
    
    /* ============================================================
       CATEGORIES
    ============================================================ */
    
    match /categories/{categoryId} {
    
      allow read:
        if true;
    
      allow create, update, delete:
        if false;
    }
    
    
    /* ============================================================
       SUBCATEGORIES
    ============================================================ */
    
    match /subcategories/{subcategoryId} {
    
      allow read:
        if true;
    
      allow create, update, delete:
        if false;
    }
    
    
    /* ============================================================
       SERVICES
    ============================================================ */
    
    match /services/{serviceId} {
    
      allow read:
        if true;
    
      allow create, update, delete:
        if false;
    }

    /* ============================================================
       SOURCE: firestore/rules/03-marketplace.rules
    ============================================================ */

    /* ============================================================
       PRODUCTS
    ============================================================ */
    
    match /products/{productId} {
    
      /* ==========================================================
         PRODUCT VIEW
    
         Signed-in user can only increment views by exactly 1.
         No other product field can be changed through this path.
      ========================================================== */
    
      function canIncrementProductView() {
        return signedIn()
    
          && request.resource.data.diff(
            resource.data
          ).affectedKeys().hasOnly([
            "views"
          ])
    
          && request.resource.data.views
            is number
    
          && request.resource.data.views
            == resource.data.get(
              "views",
              0
            ) + 1;
      }
    
    
      /* ==========================================================
         READ
      ========================================================== */
    
      allow read:
        if true;
    
    
      /* ==========================================================
         CREATE PRODUCT
    
         Only the authenticated worker can create their product.
      ========================================================== */
    
      allow create:
        if signedIn()
    
        && request.resource.data.workerId
          == request.auth.uid
    
        && workerProfileExists(
          request.auth.uid
        )
    
        && request.resource.data.name
          is string
    
        && request.resource.data.name.size()
          > 0
    
        && request.resource.data.name.size()
          <= 200
    
        && request.resource.data.category
          is string
    
        && request.resource.data.category.size()
          > 0
    
        && request.resource.data.price
          is number
    
        && request.resource.data.price
          > 0
    
        && request.resource.data.stock
          is number
    
        && request.resource.data.stock
          >= 0;
    
    
      /* ==========================================================
         WORKER PRODUCT UPDATE
    
         Existing product owner update remains unchanged.
      ========================================================== */
    
      allow update:
        if signedIn()
    
        && resource.data.workerId
          == request.auth.uid
    
        && request.resource.data.workerId
          == resource.data.workerId
    
        && request.resource.data.name
          is string
    
        && request.resource.data.name.size()
          > 0
    
        && request.resource.data.name.size()
          <= 200
    
        && request.resource.data.category
          is string
    
        && request.resource.data.category.size()
          > 0
    
        && request.resource.data.price
          is number
    
        && request.resource.data.price
          > 0
    
        && request.resource.data.stock
          is number
    
        && request.resource.data.stock
          >= 0;
    
    
      /* ==========================================================
         PRODUCT VIEW UPDATE
    
         Customer/user can increment only "views".
      ========================================================== */
    
      allow update:
        if canIncrementProductView();
    
    
      /* ==========================================================
         DELETE
    
         Only product owner can delete.
      ========================================================== */
    
      allow delete:
        if signedIn()
    
        && resource.data.workerId
          == request.auth.uid;
    }
    
    
    /* ============================================================
       PRODUCT DEALS
    ============================================================ */
    
    match /deals/{dealId} {
    
      allow read:
        if true;
    
    
      allow create:
        if signedIn()
    
        && request.resource.data.workerId
          == request.auth.uid
    
        && exists(
          /databases/$(database)/documents/products/$(request.resource.data.productId)
        )
    
        && get(
          /databases/$(database)/documents/products/$(request.resource.data.productId)
        ).data.workerId
          == request.auth.uid
    
        && request.resource.data.productId
          is string
    
        && request.resource.data.productId.size()
          > 0
    
        && request.resource.data.originalPrice
          is number
    
        && request.resource.data.originalPrice
          > 0
    
        && request.resource.data.discountedPrice
          is number
    
        && request.resource.data.discountedPrice
          > 0
    
        && request.resource.data.discountedPrice
          < request.resource.data.originalPrice
    
        && request.resource.data.discountPercentage
          is number
    
        && request.resource.data.discountPercentage
          > 0
    
        && request.resource.data.discountPercentage
          < 100
    
        && request.resource.data.startsAt
          is timestamp
    
        && request.resource.data.expiresAt
          is timestamp
    
        && request.resource.data.expiresAt
          > request.resource.data.startsAt;
    
    
      allow update:
        if signedIn()
    
        && resource.data.workerId
          == request.auth.uid
    
        && request.resource.data.workerId
          == resource.data.workerId
    
        && request.resource.data.productId
          == resource.data.productId;
    
    
      allow delete:
        if signedIn()
    
        && resource.data.workerId
          == request.auth.uid;
    }
    
    
    /* ============================================================
       SAVED WORKERS
    
       Document:
       /savedWorkers/{workerId}_{customerId}
    
       Customer:
       - Save worker
       - Check saved state
       - Unsave worker
    
       Worker:
       - Read customers who saved them
    
       Records cannot be updated.
    ============================================================ */
    
    match /savedWorkers/{savedWorkerId} {
    
      /* ==========================================================
         CREATE
      ========================================================== */
    
      allow create:
        if signedIn()
    
        && request.resource.data.customerId
          == request.auth.uid
    
        && request.resource.data.workerId
          is string
    
        && request.resource.data.workerId.size()
          > 0
    
        && request.resource.data.workerId
          != request.auth.uid
    
        && savedWorkerId
          == request.resource.data.workerId
            + "_"
            + request.auth.uid
    
        && request.resource.data.customerName
          is string
    
        && request.resource.data.customerName.size()
          > 0
    
        && request.resource.data.customerName.size()
          <= 200
    
        && request.resource.data.customerPhotoUrl
          is string
    
        && request.resource.data.createdAt
          == request.time
    
        && request.resource.data.updatedAt
          == request.time
    
        && request.resource.data.keys().hasOnly([
          "workerId",
          "customerId",
          "customerName",
          "customerPhotoUrl",
          "createdAt",
          "updatedAt"
        ]);
    
    
      /* ==========================================================
         READ
    
         Customer:
         Can read their own saved-worker relationship.
    
         Worker:
         Can read records belonging to them.
      ========================================================== */
    
      allow read:
        if signedIn()
    
        && (
          resource.data.customerId
            == request.auth.uid
    
          ||
    
          resource.data.workerId
            == request.auth.uid
        );
    
    
      /* ==========================================================
         UPDATE
    
         Save relationship is immutable.
      ========================================================== */
    
      allow update:
        if false;
    
    
      /* ==========================================================
         DELETE / UNSAVE
    
         Only the customer who saved the worker can remove it.
      ========================================================== */
    
      allow delete:
        if signedIn()
    
        && resource.data.customerId
          == request.auth.uid
    
        && savedWorkerId
          == resource.data.workerId
            + "_"
            + request.auth.uid;
    }

    /* ============================================================
       SOURCE: firestore/rules/04-bookings.rules
    ============================================================ */

    /* ============================================================
    FIXXAM — SERVICE BOOKINGS
    ============================================================ */
    
    match /bookings/{bookingId} {
    
    /* ==========================================================
    LOCAL HELPERS
    ========================================================== */
    
    function validBookingFulfillmentMode(value) {
      return value is string
        && value in [
          "worker_visits_customer",
          "customer_visits_worker",
          "remote"
        ];
    }
    
    function bookingMatchesServiceFulfillment() {
      return request.resource.data.serviceId is string
        && request.resource.data.serviceId.size() > 0
        && exists(
          /databases/$(database)/documents/services/$(request.resource.data.serviceId)
        )
        && (
          (
            get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.fulfillmentMode == "worker_visits_customer"
            && request.resource.data.fulfillmentMode == "worker_visits_customer"
          )
          ||
          (
            get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.fulfillmentMode == "customer_visits_worker"
            && request.resource.data.fulfillmentMode == "customer_visits_worker"
          )
          ||
          (
            get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.fulfillmentMode == "remote"
            && request.resource.data.fulfillmentMode == "remote"
          )
          ||
          (
            get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.fulfillmentMode == "flexible"
            && request.resource.data.fulfillmentMode in [
              "worker_visits_customer",
              "customer_visits_worker"
            ]
          )
        );
    }
    
    function validBookingLatitude(value) {
      return value is number && value >= -90 && value <= 90;
    }
    
    function validBookingLongitude(value) {
      return value is number && value >= -180 && value <= 180;
    }
    
    function validPhysicalBookingLocation() {
      return request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && validBookingLatitude(request.resource.data.latitude)
        && validBookingLongitude(request.resource.data.longitude)
        && request.resource.data.location is map
        && request.resource.data.location.address == request.resource.data.address
        && request.resource.data.location.latitude == request.resource.data.latitude
        && request.resource.data.location.longitude == request.resource.data.longitude;
    }
    
    function validRemoteBookingLocation() {
      return request.resource.data.address == ""
        && request.resource.data.latitude == null
        && request.resource.data.longitude == null
        && request.resource.data.location is map
        && request.resource.data.location.address == ""
        && request.resource.data.location.latitude == null
        && request.resource.data.location.longitude == null;
    }
    
    function validBookingLocationForFulfillment() {
      return (
        request.resource.data.fulfillmentMode == "remote"
        && validRemoteBookingLocation()
      )
      ||
      (
        request.resource.data.fulfillmentMode in [
          "worker_visits_customer",
          "customer_visits_worker"
        ]
        && validPhysicalBookingLocation()
      );
    }
    
    function initialOfferNotExpired() {
      return resource.data.offerExpiresAt is timestamp
        && resource.data.offerExpiresAt > request.time;
    }
    
    function initialWorkerOfferActive() {
      return resource.data.status == "pending"
        && resource.data.offerStatus == "sent"
        && validOfferAmount(resource.data.offerAmount)
        && resource.data.counterOfferStatus == "none"
        && resource.data.counterOfferBy == null;
    }
    
    function activeCounterBy(role) {
      return resource.data.status == "pending"
        && resource.data.offerStatus == "sent"
        && resource.data.counterOfferStatus == "sent"
        && resource.data.counterOfferBy == role
        && validOfferAmount(resource.data.counterOfferAmount);
    }
    
    /* ==========================================================
    WORKER SENDS INITIAL OFFER
    ========================================================== */
    
    function canWorkerSendInitialOffer() {
      return isBookingWorker(bookingId)
        && resource.data.status == "pending"
        && resource.data.offerStatus == "none"
        && resource.data.offerRound == 0
        && resource.data.counterOfferStatus == "none"
        && resource.data.counterOfferBy == null
        && request.resource.data.status == "pending"
        && request.resource.data.offerStatus == "sent"
        && bookingPartiesUnchanged()
        && request.resource.data.offerRound == 1
        && validOfferAmount(request.resource.data.offerAmount)
        && validOfferMessage(request.resource.data.offerMessage)
        && request.resource.data.offerWorkerId == request.auth.uid
        && request.resource.data.offerSentAt == request.time
        && request.resource.data.offerRespondedAt == null
        && (
          request.resource.data.offerExpiresAt == null
          ||
          (
            request.resource.data.offerExpiresAt is timestamp
            && request.resource.data.offerExpiresAt > request.time
          )
        )
        && request.resource.data.counterOfferAmount == null
        && request.resource.data.counterOfferMessage == null
        && request.resource.data.counterOfferBy == null
        && request.resource.data.counterOfferStatus == "none"
        && request.resource.data.counterOfferSentAt == null
        && request.resource.data.counterOfferRespondedAt == null
        && request.resource.data.negotiationStatus == "negotiating"
        && request.resource.data.agreedPrice == resource.data.agreedPrice
        && request.resource.data.updatedAt == request.time
        && bookingChangedOnly([
          "status",
          "offerAmount",
          "offerMessage",
          "offerRound",
          "offerStatus",
          "offerExpiresAt",
          "offerSentAt",
          "offerRespondedAt",
          "offerWorkerId",
          "counterOfferAmount",
          "counterOfferMessage",
          "counterOfferBy",
          "counterOfferStatus",
          "counterOfferSentAt",
          "counterOfferRespondedAt",
          "negotiationStatus",
          "updatedAt"
        ]);
    }
    
    /* ==========================================================
    CUSTOMER COUNTER OFFER
    ========================================================== */
    
    function canCustomerCounter() {
      return isBookingCustomer(bookingId)
        && resource.data.status == "pending"
        && resource.data.offerStatus == "sent"
        && validOfferRound(resource.data.offerRound)
        && resource.data.offerRound >= 1
        && request.resource.data.status == "pending"
        && request.resource.data.offerStatus == resource.data.offerStatus
        && bookingPartiesUnchanged()
        && request.resource.data.offerAmount == resource.data.offerAmount
        && request.resource.data.offerMessage == resource.data.offerMessage
        && request.resource.data.offerWorkerId == resource.data.offerWorkerId
        && request.resource.data.counterOfferBy == "customer"
        && request.resource.data.counterOfferStatus == "sent"
        && validOfferAmount(request.resource.data.counterOfferAmount)
        && validOfferMessage(request.resource.data.counterOfferMessage)
        && (
          (
            resource.data.counterOfferStatus == "none"
            && resource.data.counterOfferBy == null
            && validOfferAmount(resource.data.offerAmount)
            && initialOfferNotExpired()
            && request.resource.data.counterOfferAmount != resource.data.offerAmount
          )
          ||
          (
            activeCounterBy("worker")
            && request.resource.data.counterOfferAmount != resource.data.counterOfferAmount
          )
        )
        && request.resource.data.counterOfferSentAt == request.time
        && request.resource.data.counterOfferRespondedAt == null
        && request.resource.data.offerRespondedAt == request.time
        && request.resource.data.offerRound == resource.data.offerRound + 1
        && request.resource.data.agreedPrice == resource.data.agreedPrice
        && request.resource.data.negotiationStatus == "negotiating"
        && request.resource.data.updatedAt == request.time
        && bookingChangedOnly([
          "status",
          "counterOfferAmount",
          "counterOfferMessage",
          "counterOfferBy",
          "counterOfferStatus",
          "counterOfferSentAt",
          "counterOfferRespondedAt",
          "offerRound",
          "offerRespondedAt",
          "negotiationStatus",
          "updatedAt"
        ]);
    }
    
    /* ==========================================================
    WORKER COUNTER OFFER
    ========================================================== */
    
    function canWorkerCounter() {
      return isBookingWorker(bookingId)
        && activeCounterBy("customer")
        && validOfferRound(resource.data.offerRound)
        && resource.data.offerRound >= 2
        && request.resource.data.status == "pending"
        && request.resource.data.offerStatus == resource.data.offerStatus
        && bookingPartiesUnchanged()
        && request.resource.data.offerAmount == resource.data.offerAmount
        && request.resource.data.offerMessage == resource.data.offerMessage
        && request.resource.data.offerWorkerId == resource.data.offerWorkerId
        && request.resource.data.counterOfferBy == "worker"
        && request.resource.data.counterOfferStatus == "sent"
        && validOfferAmount(request.resource.data.counterOfferAmount)
        && request.resource.data.counterOfferAmount != resource.data.counterOfferAmount
        && validOfferMessage(request.resource.data.counterOfferMessage)
        && request.resource.data.counterOfferSentAt == request.time
        && request.resource.data.counterOfferRespondedAt == null
        && request.resource.data.offerRespondedAt == request.time
        && request.resource.data.offerRound == resource.data.offerRound + 1
        && request.resource.data.agreedPrice == resource.data.agreedPrice
        && request.resource.data.negotiationStatus == "negotiating"
        && request.resource.data.updatedAt == request.time
        && bookingChangedOnly([
          "status",
          "counterOfferAmount",
          "counterOfferMessage",
          "counterOfferBy",
          "counterOfferStatus",
          "counterOfferSentAt",
          "counterOfferRespondedAt",
          "offerRound",
          "offerRespondedAt",
          "negotiationStatus",
          "updatedAt"
        ]);
    }
    
    /* ==========================================================
    OFFER ACCEPTANCE
    ========================================================== */
    
    function canCustomerAcceptInitialOffer() {
      return isBookingCustomer(bookingId)
        && initialWorkerOfferActive()
        && initialOfferNotExpired()
        && request.resource.data.status == "accepted"
        && request.resource.data.offerStatus == "accepted"
        && request.resource.data.agreedPrice == resource.data.offerAmount
        && request.resource.data.amount == resource.data.offerAmount
        && bookingPartiesUnchanged()
        && request.resource.data.offerRespondedAt == request.time
        && request.resource.data.offerAcceptedAt == request.time
        && request.resource.data.negotiationStatus == "completed"
        && request.resource.data.updatedAt == request.time
        && bookingChangedOnly([
          "status",
          "agreedPrice",
          "amount",
          "offerStatus",
          "offerRespondedAt",
          "offerAcceptedAt",
          "negotiationStatus",
          "updatedAt"
        ]);
    }
    
    function canCustomerAcceptWorkerCounter() {
      return isBookingCustomer(bookingId)
        && activeCounterBy("worker")
        && request.resource.data.status == "accepted"
        && request.resource.data.offerStatus == "accepted"
        && request.resource.data.counterOfferStatus == "accepted"
        && request.resource.data.agreedPrice == resource.data.counterOfferAmount
        && request.resource.data.amount == resource.data.counterOfferAmount
        && bookingPartiesUnchanged()
        && request.resource.data.offerRespondedAt == request.time
        && request.resource.data.offerAcceptedAt == request.time
        && request.resource.data.counterOfferRespondedAt == request.time
        && request.resource.data.negotiationStatus == "completed"
        && request.resource.data.updatedAt == request.time
        && bookingChangedOnly([
          "status",
          "agreedPrice",
          "amount",
          "offerStatus",
          "counterOfferStatus",
          "offerRespondedAt",
          "offerAcceptedAt",
          "counterOfferRespondedAt",
          "negotiationStatus",
          "updatedAt"
        ]);
    }
    
    function canWorkerAcceptCustomerCounter() {
      return isBookingWorker(bookingId)
        && activeCounterBy("customer")
        && request.resource.data.status == "accepted"
        && request.resource.data.offerStatus == "accepted"
        && request.resource.data.counterOfferStatus == "accepted"
        && request.resource.data.agreedPrice == resource.data.counterOfferAmount
        && request.resource.data.amount == resource.data.counterOfferAmount
        && bookingPartiesUnchanged()
        && request.resource.data.offerRespondedAt == request.time
        && request.resource.data.offerAcceptedAt == request.time
        && request.resource.data.counterOfferRespondedAt == request.time
        && request.resource.data.negotiationStatus == "completed"
        && request.resource.data.updatedAt == request.time
        && bookingChangedOnly([
          "status",
          "agreedPrice",
          "amount",
          "offerStatus",
          "counterOfferStatus",
          "offerRespondedAt",
          "offerAcceptedAt",
          "counterOfferRespondedAt",
          "negotiationStatus",
          "updatedAt"
        ]);
    }
    
    /* ==========================================================
    OFFER DECLINE / CANCELLATION
    ========================================================== */
    
    function canCustomerDeclineInitialOffer() {
      return isBookingCustomer(bookingId)
        && initialWorkerOfferActive()
        && initialOfferNotExpired()
        && request.resource.data.status == "cancelled"
        && request.resource.data.offerStatus == "declined"
        && request.resource.data.cancelledBy == "customer"
        && request.resource.data.cancellationReason == "customer_cancelled"
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.offerRespondedAt == request.time
        && request.resource.data.negotiationStatus == "completed"
        && bookingPartiesUnchanged()
        && request.resource.data.updatedAt == request.time
        && bookingChangedOnly([
          "status",
          "offerStatus",
          "offerRespondedAt",
          "negotiationStatus",
          "cancellationReason",
          "cancelledBy",
          "cancelledAt",
          "updatedAt"
        ]);
    }
    
    function canCustomerDeclineWorkerCounter() {
      return isBookingCustomer(bookingId)
        && activeCounterBy("worker")
        && request.resource.data.status == "cancelled"
        && request.resource.data.offerStatus == "declined"
        && request.resource.data.counterOfferStatus == "declined"
        && request.resource.data.cancelledBy == "customer"
        && request.resource.data.cancellationReason == "customer_cancelled"
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.offerRespondedAt == request.time
        && request.resource.data.counterOfferRespondedAt == request.time
        && request.resource.data.negotiationStatus == "completed"
        && bookingPartiesUnchanged()
        && request.resource.data.updatedAt == request.time
        && bookingChangedOnly([
          "status",
          "offerStatus",
          "counterOfferStatus",
          "offerRespondedAt",
          "counterOfferRespondedAt",
          "negotiationStatus",
          "cancellationReason",
          "cancelledBy",
          "cancelledAt",
          "updatedAt"
        ]);
    }
    
    function canWorkerDeclineCustomerCounter() {
      return isBookingWorker(bookingId)
        && activeCounterBy("customer")
        && request.resource.data.status == "cancelled"
        && request.resource.data.offerStatus == "declined"
        && request.resource.data.counterOfferStatus == "declined"
        && request.resource.data.cancelledBy == "worker"
        && request.resource.data.cancellationReason == "worker_cancelled"
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.offerRespondedAt == request.time
        && request.resource.data.counterOfferRespondedAt == request.time
        && request.resource.data.negotiationStatus == "completed"
        && bookingPartiesUnchanged()
        && request.resource.data.updatedAt == request.time
        && bookingChangedOnly([
          "status",
          "offerStatus",
          "counterOfferStatus",
          "offerRespondedAt",
          "counterOfferRespondedAt",
          "negotiationStatus",
          "cancellationReason",
          "cancelledBy",
          "cancelledAt",
          "updatedAt"
        ]);
    }
    
    function canWorkerDeclineNewRequest() {
      return isBookingWorker(bookingId)
        && resource.data.status == "pending"
        && resource.data.offerStatus != "sent"
        && resource.data.offerStatus != "accepted"
        && resource.data.counterOfferStatus != "sent"
        && request.resource.data.status == "cancelled"
        && request.resource.data.offerStatus == "declined"
        && request.resource.data.counterOfferStatus == "none"
        && request.resource.data.counterOfferRespondedAt == null
        && request.resource.data.cancelledBy == "worker"
        && request.resource.data.cancellationReason == "worker_cancelled"
        && request.resource.data.get("workerDeclineReason", null) is string
        && request.resource.data.workerDeclineReason in [
          "no_longer_available",
          "outside_service_area",
          "too_busy",
          "scheduling_conflict",
          "other"
        ]
        && (
          request.resource.data.get("cancellationNote", null) == null
          ||
          (
            request.resource.data.cancellationNote is string
            && request.resource.data.cancellationNote.size() <= 500
          )
        )
        && (
          request.resource.data.workerDeclineReason != "other"
          ||
          (
            request.resource.data.get("cancellationNote", null) is string
            && request.resource.data.cancellationNote.size() > 0
            && request.resource.data.cancellationNote.size() <= 500
          )
        )
        && request.resource.data.cancelledAt == request.time
        && bookingPartiesUnchanged()
        && request.resource.data.updatedAt == request.time
        && bookingChangedOnly([
          "status",
          "offerStatus",
          "counterOfferStatus",
          "counterOfferRespondedAt",
          "cancellationReason",
          "cancelledBy",
          "workerDeclineReason",
          "cancellationNote",
          "cancelledAt",
          "updatedAt"
        ]);
    }
    
    function canCustomerCancelWithReason() {
      return isBookingCustomer(bookingId)
        && resource.data.status == "pending"
        && resource.data.get("offerStatus", "none") != "sent"
        && resource.data.get("counterOfferStatus", "none") != "sent"
        && request.resource.data.status == "cancelled"
        && request.resource.data.cancelledBy == "customer"
        && request.resource.data.get("cancellationReason", null) is string
        && request.resource.data.get("cancellationReason", null) in [
          "not_ready",
          "accidental_request",
          "request_later",
          "personal_reason",
          "other"
        ]
        && (
          request.resource.data.get("cancellationNote", null) == null
          ||
          (
            request.resource.data.get("cancellationNote", null) is string
            && request.resource.data.get("cancellationNote", null).size() <= 500
          )
        )
        && (
          request.resource.data.get("cancellationReason", null) != "other"
          ||
          (
            request.resource.data.get("cancellationNote", null) is string
            && request.resource.data.get("cancellationNote", null).size() > 0
            && request.resource.data.get("cancellationNote", null).size() <= 500
          )
        )
        && request.resource.data.cancelledAt == request.time
        && bookingPartiesUnchanged()
        && request.resource.data.updatedAt == request.time
        && bookingChangedOnly([
          "status",
          "cancellationReason",
          "cancellationNote",
          "cancelledBy",
          "cancelledAt",
          "updatedAt"
        ]);
    }
    
    /* ==========================================================
    JOURNEY AND ARRIVAL
    ========================================================== */
    
    function canWorkerStartJourney() {
      return isBookingWorker(bookingId)
        && resource.data.fulfillmentMode in [
          "worker_visits_customer",
          "customer_visits_worker"
        ]
        && resource.data.status == "accepted"
        && request.resource.data.status == resource.data.status
        && request.resource.data.estimatedArrival is string
        && request.resource.data.estimatedArrival.size() > 0
        && request.resource.data.estimatedArrival.size() <= 120
        && bookingPartiesUnchanged()
        && request.resource.data.updatedAt == request.time
        && bookingChangedOnly(["estimatedArrival", "updatedAt"]);
    }
    
    function canWorkerMarkArrived() {
      return isBookingWorker(bookingId)
        && resource.data.fulfillmentMode in [
          "worker_visits_customer",
          "customer_visits_worker"
        ]
        && resource.data.status in ["accepted", "in-progress"]
        && request.resource.data.status == resource.data.status
        && request.resource.data.workerArrivedAt == request.time
        && bookingPartiesUnchanged()
        && request.resource.data.updatedAt == request.time
        && (
          !("workerArrivedAt" in resource.data)
          || resource.data.workerArrivedAt == null
        )
        && bookingChangedOnly(["workerArrivedAt", "updatedAt"]);
    }
    
    /* ==========================================================
    SERVICE START PERMISSION
    ========================================================== */
    
    function canWorkerStartService() {
      return isBookingWorker(bookingId)
        && resource.data.status == "accepted"
        && resource.data.get(
          "startConfirmationRequestedAt",
          null
        ) == null
        && request.resource.data.status == "accepted"
        && bookingPartiesUnchanged()
        && request.resource.data.startConfirmationRequestedAt
          == request.time
        && request.resource.data.customerStartedConfirmedAt
          == null
        && request.resource.data.updatedAt == request.time
        && bookingChangedOnly([
          "startConfirmationRequestedAt",
          "customerStartedConfirmedAt",
          "updatedAt"
        ]);
    }
    
    
    /* ==========================================================
    CUSTOMER CONFIRMS SERVICE START
    ========================================================== */
    
    function canCustomerConfirmServiceStart() {
      return isBookingCustomer(bookingId)
        && resource.data.status == "accepted"
        && resource.data.startConfirmationRequestedAt is timestamp
        && resource.data.get("customerStartedConfirmedAt", null) == null
        && request.resource.data.status == "in-progress"
        && bookingPartiesUnchanged()
        && request.resource.data.customerStartedConfirmedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.startedAt == request.time
    && request.resource.data.serviceStartedAt == request.time
        && bookingChangedOnly([
      "status",
      "customerStartedConfirmedAt",
      "startedAt",
      "serviceStartedAt",
      "updatedAt"
    ]);
    }
    
    
    /* ==========================================================
    WORKER MARKS SERVICE COMPLETED
    ========================================================== */
    
    function canWorkerMarkServiceCompleted() {
      return isBookingWorker(bookingId)
        && resource.data.status == "in-progress"
        && request.resource.data.status
          == "awaiting_completion_confirmation"
        && bookingPartiesUnchanged()
        && request.resource.data.workerMarkedCompletedAt
          == request.time
        && request.resource.data.updatedAt
          == request.time
        && bookingChangedOnly([
          "status",
          "workerMarkedCompletedAt",
          "updatedAt"
        ]);
    }
    
    /* ==========================================================
    CUSTOMER CONFIRMS SERVICE COMPLETION
    ========================================================== */
    
    function canCustomerConfirmServiceCompleted() {
      return isBookingCustomer(bookingId)
        && resource.data.status
          == "awaiting_completion_confirmation"
        && resource.data.workerMarkedCompletedAt is timestamp
        && resource.data.get(
          "customerCompletedConfirmedAt",
          null
        ) == null
        && resource.data.agreedPrice is number
        && resource.data.agreedPrice > 0
    
        && request.resource.data.status
          == "completed"
    
        && request.resource.data.amount
          == resource.data.agreedPrice
    
        && request.resource.data.customerCompletedConfirmedAt
          == request.time
    
        && request.resource.data.serviceCompletedAt
          == request.time
    
        && request.resource.data.completedAt
          == request.time
    
        && request.resource.data.updatedAt
          == request.time
    
        && bookingPartiesUnchanged()
    
        && bookingChangedOnly([
          "status",
          "amount",
          "serviceCompletedAt",
          "completedAt",
          "customerCompletedConfirmedAt",
          "updatedAt"
        ]);
    }
    
    /* ==========================================================
    READ
    ========================================================== */
    
    allow read:
      if signedIn()
      && (
        resource.data.customerId == request.auth.uid
        || resource.data.workerId == request.auth.uid
      );
    
    /* ==========================================================
    CREATE
    ========================================================== */
    
    allow create:
      if signedIn()
      && request.resource.data.customerId == request.auth.uid
      && request.resource.data.workerId is string
      && request.resource.data.workerId.size() > 0
      && request.resource.data.workerId != request.auth.uid
      && validBookingFulfillmentMode(request.resource.data.fulfillmentMode)
      && bookingMatchesServiceFulfillment()
      && validBookingLocationForFulfillment()
      && request.resource.data.status == "pending"
      && validNullableOfferAmount(request.resource.data.amount)
      && request.resource.data.agreedPrice == null
      && request.resource.data.offerAmount == null
      && request.resource.data.offerMessage == null
      && request.resource.data.offerRound == 0
      && request.resource.data.offerStatus == "none"
      && request.resource.data.offerExpiresAt == null
      && request.resource.data.offerSentAt == null
      && request.resource.data.offerRespondedAt == null
      && request.resource.data.get("offerAcceptedAt", null) == null
      && request.resource.data.offerWorkerId == null
      && request.resource.data.counterOfferAmount == null
      && request.resource.data.counterOfferMessage == null
      && request.resource.data.counterOfferBy == null
      && request.resource.data.counterOfferStatus == "none"
      && request.resource.data.counterOfferSentAt == null
      && request.resource.data.counterOfferRespondedAt == null
      && request.resource.data.negotiationStatus == "none"
      && request.resource.data.paymentStatus == "pending"
      && request.resource.data.get("cancellationReason", null) == null
      && request.resource.data.get("cancelledBy", null) == null
      && request.resource.data.get("cancelledAt", null) == null
      && request.resource.data.get("deletedByCustomer", false) == false
      && request.resource.data.get("deletedByCustomerAt", null) == null
      && request.resource.data.get("deletedByWorker", false) == false
      && request.resource.data.get("deletedByWorkerAt", null) == null
      && request.resource.data.createdAt == request.time
      && request.resource.data.updatedAt == request.time;
    
    /* ==========================================================
    UPDATE — EXPLICIT AUTHORIZED ACTIONS ONLY
    ========================================================== */
    
    allow update:
      if signedIn()
      && (
        canWorkerSendInitialOffer()
        || canCustomerCounter()
        || canWorkerCounter()
        || canCustomerAcceptInitialOffer()
        || canCustomerAcceptWorkerCounter()
        || canWorkerAcceptCustomerCounter()
        || canCustomerDeclineInitialOffer()
        || canCustomerDeclineWorkerCounter()
        || canWorkerDeclineCustomerCounter()
        || canWorkerDeclineNewRequest()
        || canCustomerCancelWithReason()
        || canWorkerStartJourney()
        || canWorkerMarkArrived()
        || canWorkerStartService()
        || canCustomerConfirmServiceStart()
        || canWorkerMarkServiceCompleted()
        || canCustomerConfirmServiceCompleted()
    
      );
    
    /* ==========================================================
    DELETE DISABLED
    ========================================================== */
    
    allow delete: if false;
    }

    /* ============================================================
       SOURCE: firestore/rules/11-booking.service.rules
    ============================================================ */

    /*
     * 11-booking.service.rules
     *
     * Service lifecycle permissions are maintained in:
     * firestore/rules/04-bookings.rules
     *
     * Do not declare another match /bookings/{bookingId} here.
     * This avoids duplicate lifecycle functions and overlapping
     * authorization logic.
     *
     * Lifecycle:
     * accepted
     *   -> accepted (worker requests start confirmation)
     *   -> in-progress (customer confirms start)
     *   -> awaiting_completion_confirmation
     *   -> completed
     *
     * This source file intentionally contains no additional rules.
     */

    /* ============================================================
       SOURCE: firestore/rules/12-booking.counter.rules
    ============================================================ */

    /* ============================================================
       12-BOOKING.COUNTER.RULES
    
       Booking price negotiation:
       - Worker initial offer
       - Customer counter-offer
       - Worker counter-offer
       - Offer acceptance
       - Offer decline
    ============================================================ */
    
    match /bookings/{bookingId} {
    
      /* ==========================================================
         INITIAL OFFER EXPIRY
      ========================================================== */
    
      function initialOfferNotExpired() {
        return resource.data.offerExpiresAt is timestamp
          && resource.data.offerExpiresAt > request.time;
      }
    
    
      /* ==========================================================
         INITIAL WORKER OFFER ACTIVE
      ========================================================== */
    
      function initialWorkerOfferActive() {
        return resource.data.status == "pending"
          && resource.data.offerStatus == "sent"
          && validOfferAmount(resource.data.offerAmount)
          && resource.data.counterOfferStatus == "none"
          && resource.data.counterOfferBy == null;
      }
    
    
      /* ==========================================================
         ACTIVE COUNTER OFFER
      ========================================================== */
    
      function activeCounterBy(role) {
        return resource.data.status == "pending"
          && resource.data.offerStatus == "sent"
          && resource.data.counterOfferStatus == "sent"
          && resource.data.counterOfferBy == role
          && validOfferAmount(resource.data.counterOfferAmount);
      }
    
    
      /* ==========================================================
         WORKER SENDS INITIAL OFFER
      ========================================================== */
    
      function canWorkerSendInitialOffer() {
        return isBookingWorker(bookingId)
          && resource.data.status == "pending"
          && resource.data.offerStatus == "none"
          && resource.data.offerRound == 0
          && resource.data.counterOfferStatus == "none"
          && resource.data.counterOfferBy == null
          && request.resource.data.status == "pending"
          && request.resource.data.offerStatus == "sent"
          && bookingPartiesUnchanged()
          && request.resource.data.offerRound == 1
          && validOfferAmount(request.resource.data.offerAmount)
          && validOfferMessage(request.resource.data.offerMessage)
          && request.resource.data.offerWorkerId == request.auth.uid
          && request.resource.data.offerSentAt == request.time
          && request.resource.data.offerRespondedAt == null
          && (
            request.resource.data.offerExpiresAt == null
            || (
              request.resource.data.offerExpiresAt is timestamp
              && request.resource.data.offerExpiresAt > request.time
            )
          )
          && request.resource.data.counterOfferAmount == null
          && request.resource.data.counterOfferMessage == null
          && request.resource.data.counterOfferBy == null
          && request.resource.data.counterOfferStatus == "none"
          && request.resource.data.counterOfferSentAt == null
          && request.resource.data.counterOfferRespondedAt == null
          && request.resource.data.negotiationStatus == "negotiating"
          && request.resource.data.agreedPrice == resource.data.agreedPrice
          && request.resource.data.updatedAt == request.time
          && bookingChangedOnly([
            "status",
            "offerAmount",
            "offerMessage",
            "offerRound",
            "offerStatus",
            "offerExpiresAt",
            "offerSentAt",
            "offerRespondedAt",
            "offerWorkerId",
            "counterOfferAmount",
            "counterOfferMessage",
            "counterOfferBy",
            "counterOfferStatus",
            "counterOfferSentAt",
            "counterOfferRespondedAt",
            "negotiationStatus",
            "updatedAt"
          ]);
      }
    
    
      /* ==========================================================
         CUSTOMER COUNTER-OFFER
      ========================================================== */
    
      function canCustomerCounter() {
        return isBookingCustomer(bookingId)
          && resource.data.status == "pending"
          && resource.data.offerStatus == "sent"
          && validOfferRound(resource.data.offerRound)
          && resource.data.offerRound >= 1
          && request.resource.data.status == "pending"
          && request.resource.data.offerStatus == resource.data.offerStatus
          && bookingPartiesUnchanged()
          && request.resource.data.offerAmount == resource.data.offerAmount
          && request.resource.data.offerMessage == resource.data.offerMessage
          && request.resource.data.offerWorkerId == resource.data.offerWorkerId
          && request.resource.data.counterOfferBy == "customer"
          && request.resource.data.counterOfferStatus == "sent"
          && validOfferAmount(request.resource.data.counterOfferAmount)
          && validOfferMessage(request.resource.data.counterOfferMessage)
          && (
            (
              resource.data.counterOfferStatus == "none"
              && resource.data.counterOfferBy == null
              && validOfferAmount(resource.data.offerAmount)
              && initialOfferNotExpired()
              && request.resource.data.counterOfferAmount != resource.data.offerAmount
            )
            ||
            (
              activeCounterBy("worker")
              && request.resource.data.counterOfferAmount != resource.data.counterOfferAmount
            )
          )
          && request.resource.data.counterOfferSentAt == request.time
          && request.resource.data.counterOfferRespondedAt == null
          && request.resource.data.offerRespondedAt == request.time
          && request.resource.data.offerRound == resource.data.offerRound + 1
          && request.resource.data.agreedPrice == resource.data.agreedPrice
          && request.resource.data.negotiationStatus == "negotiating"
          && request.resource.data.updatedAt == request.time
          && bookingChangedOnly([
            "status",
            "counterOfferAmount",
            "counterOfferMessage",
            "counterOfferBy",
            "counterOfferStatus",
            "counterOfferSentAt",
            "counterOfferRespondedAt",
            "offerRound",
            "offerRespondedAt",
            "negotiationStatus",
            "updatedAt"
          ]);
      }
    
    
      /* ==========================================================
         WORKER COUNTER-OFFER
      ========================================================== */
    
      function canWorkerCounter() {
        return isBookingWorker(bookingId)
          && activeCounterBy("customer")
          && validOfferRound(resource.data.offerRound)
          && resource.data.offerRound >= 2
          && request.resource.data.status == "pending"
          && request.resource.data.offerStatus == resource.data.offerStatus
          && bookingPartiesUnchanged()
          && request.resource.data.offerAmount == resource.data.offerAmount
          && request.resource.data.offerMessage == resource.data.offerMessage
          && request.resource.data.offerWorkerId == resource.data.offerWorkerId
          && request.resource.data.counterOfferBy == "worker"
          && request.resource.data.counterOfferStatus == "sent"
          && validOfferAmount(request.resource.data.counterOfferAmount)
          && request.resource.data.counterOfferAmount != resource.data.counterOfferAmount
          && validOfferMessage(request.resource.data.counterOfferMessage)
          && request.resource.data.counterOfferSentAt == request.time
          && request.resource.data.counterOfferRespondedAt == null
          && request.resource.data.offerRespondedAt == request.time
          && request.resource.data.offerRound == resource.data.offerRound + 1
          && request.resource.data.agreedPrice == resource.data.agreedPrice
          && request.resource.data.negotiationStatus == "negotiating"
          && request.resource.data.updatedAt == request.time
          && bookingChangedOnly([
            "status",
            "counterOfferAmount",
            "counterOfferMessage",
            "counterOfferBy",
            "counterOfferStatus",
            "counterOfferSentAt",
            "counterOfferRespondedAt",
            "offerRound",
            "offerRespondedAt",
            "negotiationStatus",
            "updatedAt"
          ]);
      }
    
    
      /* ==========================================================
         CUSTOMER ACCEPTS INITIAL OFFER
      ========================================================== */
    
      function canCustomerAcceptInitialOffer() {
        return isBookingCustomer(bookingId)
          && initialWorkerOfferActive()
          && initialOfferNotExpired()
          && request.resource.data.status == "accepted"
          && request.resource.data.offerStatus == "accepted"
          && request.resource.data.agreedPrice == resource.data.offerAmount
          && request.resource.data.amount == resource.data.offerAmount
          && bookingPartiesUnchanged()
          && request.resource.data.offerRespondedAt == request.time
          && request.resource.data.offerAcceptedAt == request.time
          && request.resource.data.negotiationStatus == "completed"
          && request.resource.data.updatedAt == request.time
          && bookingChangedOnly([
            "status",
            "agreedPrice",
            "amount",
            "offerStatus",
            "offerRespondedAt",
            "offerAcceptedAt",
            "negotiationStatus",
            "updatedAt"
          ]);
      }
    
    
      /* ==========================================================
         CUSTOMER ACCEPTS WORKER COUNTER
      ========================================================== */
    
      function canCustomerAcceptWorkerCounter() {
        return isBookingCustomer(bookingId)
          && activeCounterBy("worker")
          && request.resource.data.status == "accepted"
          && request.resource.data.offerStatus == "accepted"
          && request.resource.data.counterOfferStatus == "accepted"
          && request.resource.data.agreedPrice == resource.data.counterOfferAmount
          && request.resource.data.amount == resource.data.counterOfferAmount
          && bookingPartiesUnchanged()
          && request.resource.data.offerRespondedAt == request.time
          && request.resource.data.offerAcceptedAt == request.time
          && request.resource.data.counterOfferRespondedAt == request.time
          && request.resource.data.negotiationStatus == "completed"
          && request.resource.data.updatedAt == request.time
          && bookingChangedOnly([
            "status",
            "agreedPrice",
            "amount",
            "offerStatus",
            "counterOfferStatus",
            "offerRespondedAt",
            "offerAcceptedAt",
            "counterOfferRespondedAt",
            "negotiationStatus",
            "updatedAt"
          ]);
      }
    
    
      /* ==========================================================
         WORKER ACCEPTS CUSTOMER COUNTER
      ========================================================== */
    
      function canWorkerAcceptCustomerCounter() {
        return isBookingWorker(bookingId)
          && activeCounterBy("customer")
          && request.resource.data.status == "accepted"
          && request.resource.data.offerStatus == "accepted"
          && request.resource.data.counterOfferStatus == "accepted"
          && request.resource.data.agreedPrice == resource.data.counterOfferAmount
          && request.resource.data.amount == resource.data.counterOfferAmount
          && bookingPartiesUnchanged()
          && request.resource.data.offerRespondedAt == request.time
          && request.resource.data.offerAcceptedAt == request.time
          && request.resource.data.counterOfferRespondedAt == request.time
          && request.resource.data.negotiationStatus == "completed"
          && request.resource.data.updatedAt == request.time
          && bookingChangedOnly([
            "status",
            "agreedPrice",
            "amount",
            "offerStatus",
            "counterOfferStatus",
            "offerRespondedAt",
            "offerAcceptedAt",
            "counterOfferRespondedAt",
            "negotiationStatus",
            "updatedAt"
          ]);
      }
    
    
      /* ==========================================================
         CUSTOMER DECLINES INITIAL OFFER
      ========================================================== */
    
      function canCustomerDeclineInitialOffer() {
        return isBookingCustomer(bookingId)
          && initialWorkerOfferActive()
          && initialOfferNotExpired()
          && request.resource.data.status == "cancelled"
          && request.resource.data.offerStatus == "declined"
          && request.resource.data.cancelledBy == "customer"
          && request.resource.data.cancellationReason == "customer_cancelled"
          && request.resource.data.cancelledAt == request.time
          && request.resource.data.offerRespondedAt == request.time
          && request.resource.data.negotiationStatus == "completed"
          && bookingPartiesUnchanged()
          && request.resource.data.updatedAt == request.time
          && bookingChangedOnly([
            "status",
            "offerStatus",
            "offerRespondedAt",
            "negotiationStatus",
            "cancellationReason",
            "cancelledBy",
            "cancelledAt",
            "updatedAt"
          ]);
      }
    
    
      /* ==========================================================
         CUSTOMER DECLINES WORKER COUNTER
      ========================================================== */
    
      function canCustomerDeclineWorkerCounter() {
        return isBookingCustomer(bookingId)
          && activeCounterBy("worker")
          && request.resource.data.status == "cancelled"
          && request.resource.data.offerStatus == "declined"
          && request.resource.data.counterOfferStatus == "declined"
          && request.resource.data.cancelledBy == "customer"
          && request.resource.data.cancellationReason == "customer_cancelled"
          && request.resource.data.cancelledAt == request.time
          && request.resource.data.offerRespondedAt == request.time
          && request.resource.data.counterOfferRespondedAt == request.time
          && request.resource.data.negotiationStatus == "completed"
          && bookingPartiesUnchanged()
          && request.resource.data.updatedAt == request.time
          && bookingChangedOnly([
            "status",
            "offerStatus",
            "counterOfferStatus",
            "offerRespondedAt",
            "counterOfferRespondedAt",
            "negotiationStatus",
            "cancellationReason",
            "cancelledBy",
            "cancelledAt",
            "updatedAt"
          ]);
      }
    
    
      /* ==========================================================
         WORKER DECLINES CUSTOMER COUNTER
      ========================================================== */
    
      function canWorkerDeclineCustomerCounter() {
        return isBookingWorker(bookingId)
          && activeCounterBy("customer")
          && request.resource.data.status == "cancelled"
          && request.resource.data.offerStatus == "declined"
          && request.resource.data.counterOfferStatus == "declined"
          && request.resource.data.cancelledBy == "worker"
          && request.resource.data.cancellationReason == "worker_cancelled"
          && request.resource.data.cancelledAt == request.time
          && request.resource.data.offerRespondedAt == request.time
          && request.resource.data.counterOfferRespondedAt == request.time
          && request.resource.data.negotiationStatus == "completed"
          && bookingPartiesUnchanged()
          && request.resource.data.updatedAt == request.time
          && bookingChangedOnly([
            "status",
            "offerStatus",
            "counterOfferStatus",
            "offerRespondedAt",
            "counterOfferRespondedAt",
            "negotiationStatus",
            "cancellationReason",
            "cancelledBy",
            "cancelledAt",
            "updatedAt"
          ]);
      }
    
    
      /* ==========================================================
         PRICE NEGOTIATION UPDATE PERMISSIONS
      ========================================================== */
    
      allow update:
        if signedIn()
        && (
          canWorkerSendInitialOffer()
          || canCustomerCounter()
          || canWorkerCounter()
          || canCustomerAcceptInitialOffer()
          || canCustomerAcceptWorkerCounter()
          || canWorkerAcceptCustomerCounter()
          || canCustomerDeclineInitialOffer()
          || canCustomerDeclineWorkerCounter()
          || canWorkerDeclineCustomerCounter()
        );
    }

    /* ============================================================
       SOURCE: firestore/rules/13-bookings.order.rules
    ============================================================ */

    /* ============================================================
       13-BOOKINGS.ORDER.RULES
    
       Partial Firestore rules source.
       Booking creation remains in 04-bookings.rules.
       Service lifecycle remains in 11-booking.service.rules.
       Negotiation remains in 12-booking.counter.rules.
    
       These uniquely named helpers avoid collisions while the
       legacy 04-bookings.rules is being consolidated.
    ============================================================ */
    
    match /bookings/{bookingId} {
    
      /* ==========================================================
         WORKER DECLINES A NEW REQUEST
      ========================================================== */
    
      function orderCanWorkerDeclineNewRequest() {
        return isBookingWorker(bookingId)
          && resource.data.status == "pending"
          && resource.data.get("offerStatus", "none") != "sent"
          && resource.data.get("offerStatus", "none") != "accepted"
          && resource.data.get("counterOfferStatus", "none") != "sent"
    
          && request.resource.data.status == "cancelled"
          && request.resource.data.offerStatus == "declined"
          && request.resource.data.counterOfferStatus == "none"
          && request.resource.data.counterOfferRespondedAt == null
    
          && request.resource.data.cancelledBy == "worker"
          && request.resource.data.cancellationReason == "worker_cancelled"
    
          && request.resource.data.get("workerDeclineReason", null) is string
          && request.resource.data.workerDeclineReason in [
            "no_longer_available",
            "outside_service_area",
            "too_busy",
            "scheduling_conflict",
            "other"
          ]
    
          && (
            request.resource.data.get("cancellationNote", null) == null
            ||
            (
              request.resource.data.cancellationNote is string
              && request.resource.data.cancellationNote.size() <= 500
            )
          )
    
          && (
            request.resource.data.workerDeclineReason != "other"
            ||
            (
              request.resource.data.get("cancellationNote", null) is string
              && request.resource.data.cancellationNote.size() > 0
              && request.resource.data.cancellationNote.size() <= 500
            )
          )
    
          && request.resource.data.cancelledAt == request.time
          && bookingPartiesUnchanged()
          && request.resource.data.updatedAt == request.time
    
          && bookingChangedOnly([
            "status",
            "offerStatus",
            "counterOfferStatus",
            "counterOfferRespondedAt",
            "cancellationReason",
            "cancelledBy",
            "workerDeclineReason",
            "cancellationNote",
            "cancelledAt",
            "updatedAt"
          ]);
      }
    
    
      /* ==========================================================
         CUSTOMER CANCELS BEFORE NEGOTIATION
      ========================================================== */
    
      function orderCanCustomerCancelPendingBooking() {
        return isBookingCustomer(bookingId)
          && resource.data.status == "pending"
          && resource.data.get("offerStatus", "none") != "sent"
          && resource.data.get("counterOfferStatus", "none") != "sent"
    
          && request.resource.data.status == "cancelled"
          && request.resource.data.cancelledBy == "customer"
    
          && request.resource.data.cancellationReason is string
          && request.resource.data.cancellationReason in [
            "not_ready",
            "accidental_request",
            "request_later",
            "personal_reason",
            "other"
          ]
    
          && (
            request.resource.data.get("cancellationNote", null) == null
            ||
            (
              request.resource.data.cancellationNote is string
              && request.resource.data.cancellationNote.size() <= 500
            )
          )
    
          && (
            request.resource.data.cancellationReason != "other"
            ||
            (
              request.resource.data.get("cancellationNote", null) is string
              && request.resource.data.cancellationNote.size() > 0
              && request.resource.data.cancellationNote.size() <= 500
            )
          )
    
          && request.resource.data.cancelledAt == request.time
          && bookingPartiesUnchanged()
          && request.resource.data.updatedAt == request.time
    
          && bookingChangedOnly([
            "status",
            "cancellationReason",
            "cancellationNote",
            "cancelledBy",
            "cancelledAt",
            "updatedAt"
          ]);
      }
    
    
      /* ==========================================================
         CUSTOMER HIDES COMPLETED/CANCELLED HISTORY
      ========================================================== */
    
      function orderCanCustomerHideBookingHistory() {
        return isBookingCustomer(bookingId)
          && resource.data.customerId == request.auth.uid
          && resource.data.status in [
            "completed",
            "cancelled",
            "canceled",
            "expired"
          ]
    
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.workerId == resource.data.workerId
          && request.resource.data.status == resource.data.status
    
          && request.resource.data.deletedByCustomer == true
          && request.resource.data.deletedByCustomerAt == request.time
          && request.resource.data.updatedAt == request.time
    
          && bookingChangedOnly([
            "deletedByCustomer",
            "deletedByCustomerAt",
            "updatedAt"
          ]);
      }
    
    
      /* ==========================================================
         WORKER HIDES COMPLETED/CANCELLED HISTORY
      ========================================================== */
    
      function orderCanWorkerHideBookingHistory() {
        return isBookingWorker(bookingId)
          && resource.data.workerId == request.auth.uid
          && resource.data.status in [
            "completed",
            "cancelled",
            "canceled",
            "expired"
          ]
    
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.workerId == resource.data.workerId
          && request.resource.data.status == resource.data.status
    
          && request.resource.data.deletedByWorker == true
          && request.resource.data.deletedByWorkerAt == request.time
          && request.resource.data.updatedAt == request.time
    
          && bookingChangedOnly([
            "deletedByWorker",
            "deletedByWorkerAt",
            "updatedAt"
          ]);
      }
    
    
      /* ==========================================================
         ORDER UPDATE PERMISSIONS
      ========================================================== */
    
      allow update: if signedIn()
        && (
          orderCanWorkerDeclineNewRequest()
          || orderCanCustomerCancelPendingBooking()
          || orderCanCustomerHideBookingHistory()
          || orderCanWorkerHideBookingHistory()
        );
    }

    /* ============================================================
       SOURCE: firestore/rules/05-market-orders.rules
    ============================================================ */

    /* ============================================================
       MARKET ORDERS
    ============================================================ */
    
    match /orders/{orderId} {
    
      /* ==========================================================
         LOCAL HELPERS
      ========================================================== */
    
      function marketOrderPartiesUnchanged() {
        return request.resource.data.customerId
            == resource.data.customerId
    
          && (
            (
              !("workerId" in resource.data)
              && !("workerId" in request.resource.data)
            )
    
            ||
    
            (
              ("workerId" in resource.data)
              && ("workerId" in request.resource.data)
    
              && request.resource.data.workerId
                == resource.data.workerId
            )
          )
    
          && (
            (
              !("sellerId" in resource.data)
              && !("sellerId" in request.resource.data)
            )
    
            ||
    
            (
              ("sellerId" in resource.data)
              && ("sellerId" in request.resource.data)
    
              && request.resource.data.sellerId
                == resource.data.sellerId
            )
          );
      }
    
    
      function isTerminalMarketOrderStatus() {
        return resource.data.status
          in [
            "completed",
            "delivered",
            "cancelled",
            "canceled",
            "expired",
            "declined"
          ];
      }
    
    
      /* ==========================================================
         CUSTOMER HIDES MARKET ORDER HISTORY
    
         Customer-specific soft delete.
         Worker/seller/platform records remain intact.
      ========================================================== */
    
      function canCustomerHideMarketOrderHistory() {
        return signedIn()
    
          && resource.data.customerId
            == request.auth.uid
    
          && isTerminalMarketOrderStatus()
    
          && marketOrderPartiesUnchanged()
    
          && request.resource.data.status
            == resource.data.status
    
          && resource.data.get(
            "deletedByCustomer",
            false
          ) != true
    
          && request.resource.data.deletedByCustomer
            == true
    
          && request.resource.data.deletedByCustomerAt
            == request.time
    
          && request.resource.data.updatedAt
            == request.time
    
          && request.resource.data.diff(
            resource.data
          ).affectedKeys().hasOnly([
            "deletedByCustomer",
            "deletedByCustomerAt",
            "updatedAt"
          ]);
      }
    
    
      /* ==========================================================
         WORKER HIDES MARKET ORDER HISTORY
    
         Worker-specific soft delete.
         Customer/seller/platform records remain intact.
      ========================================================== */
    
      function canWorkerHideMarketOrderHistory() {
        return signedIn()
    
          && ("workerId" in resource.data)
    
          && resource.data.workerId
            == request.auth.uid
    
          && isTerminalMarketOrderStatus()
    
          && marketOrderPartiesUnchanged()
    
          && request.resource.data.status
            == resource.data.status
    
          && resource.data.get(
            "deletedByWorker",
            false
          ) != true
    
          && request.resource.data.deletedByWorker
            == true
    
          && request.resource.data.deletedByWorkerAt
            == request.time
    
          && request.resource.data.updatedAt
            == request.time
    
          && request.resource.data.diff(
            resource.data
          ).affectedKeys().hasOnly([
            "deletedByWorker",
            "deletedByWorkerAt",
            "updatedAt"
          ]);
      }
    
    
      /* ==========================================================
         NORMAL PARTICIPANT UPDATE
    
         Existing order lifecycle remains supported.
    
         History ownership fields are protected from the normal
         update path.
      ========================================================== */
    
      function canParticipantUpdateMarketOrder() {
        return signedIn()
    
          && (
            resource.data.customerId
              == request.auth.uid
    
            ||
    
            (
              ("workerId" in resource.data)
    
              && resource.data.workerId
                == request.auth.uid
            )
    
            ||
    
            (
              ("sellerId" in resource.data)
    
              && resource.data.sellerId
                == request.auth.uid
            )
          )
    
          && marketOrderPartiesUnchanged()
    
          && !request.resource.data.diff(
            resource.data
          ).affectedKeys().hasAny([
            "deletedByCustomer",
            "deletedByCustomerAt",
            "deletedByWorker",
            "deletedByWorkerAt"
          ]);
      }
    
    
      /* ==========================================================
         READ
      ========================================================== */
    
      allow read:
        if signedIn()
    
        && (
          resource.data.customerId
            == request.auth.uid
    
          ||
    
          (
            ("workerId" in resource.data)
    
            && resource.data.workerId
              == request.auth.uid
          )
    
          ||
    
          (
            ("sellerId" in resource.data)
    
            && resource.data.sellerId
              == request.auth.uid
          )
        );
    
    
      /* ==========================================================
         CUSTOMER MARKET ORDER HISTORY — DEDICATED UPDATE
    
         Customer can hide only their own terminal order history.
      ========================================================== */
    
      allow update:
        if canCustomerHideMarketOrderHistory();
    
    
      /* ==========================================================
         WORKER MARKET ORDER HISTORY — DEDICATED UPDATE
    
         Worker can hide only their own terminal order history.
      ========================================================== */
    
      allow update:
        if canWorkerHideMarketOrderHistory();
    
    
      /* ==========================================================
         CREATE
    
         New orders cannot start already hidden from either
         customer or worker history.
      ========================================================== */
    
      allow create:
        if signedIn()
    
        && (
          request.resource.data.customerId
            == request.auth.uid
    
          ||
    
          (
            ("workerId" in request.resource.data)
    
            && request.resource.data.workerId
              == request.auth.uid
          )
    
          ||
    
          (
            ("sellerId" in request.resource.data)
    
            && request.resource.data.sellerId
              == request.auth.uid
          )
        )
    
        && (
          !("workerId" in request.resource.data)
    
          ||
    
          request.resource.data.customerId
            != request.resource.data.workerId
        )
    
        && request.resource.data.get(
          "deletedByCustomer",
          false
        ) == false
    
        && request.resource.data.get(
          "deletedByWorker",
          false
        ) == false
    
        && request.resource.data.get(
          "deletedByCustomerAt",
          null
        ) == null
    
        && request.resource.data.get(
          "deletedByWorkerAt",
          null
        ) == null;
    
    
      /* ==========================================================
         NORMAL MARKET ORDER UPDATE
    
         Lifecycle updates remain separate from history removal.
         History flags cannot be changed through this path.
      ========================================================== */
    
      allow update:
        if canParticipantUpdateMarketOrder();
    
    
      /* ==========================================================
         DELETE
    
         Orders are retained permanently at this security layer.
         History removal is role-specific soft-delete only.
      ========================================================== */
    
      allow delete:
        if false;
    }
    
    
    /* ============================================================
       MARKET CHATS
    
       ARCHITECTURE:
    
       /orders/{orderId}
    
       /marketChats/{orderId}
    
       /marketChats/{orderId}/messages/{messageId}
    
       Therefore:
       chatId == orderId
    ============================================================ */
    
    match /marketChats/{chatId} {
    
      /* ==========================================================
         CREATE CHAT
      ========================================================== */
    
      allow create:
        if signedIn()
    
        && request.resource.data.orderId
          is string
    
        && request.resource.data.orderId
          == chatId
    
        && marketOrderExists(
          chatId
        )
    
        && isMarketOrderParticipant(
          chatId
        )
    
        && request.resource.data.customerId
          == currentMarketOrder(
            chatId
          ).customerId
    
        && (
          !(
            "workerId"
            in request.resource.data
          )
    
          ||
    
          (
            (
              "workerId"
              in currentMarketOrder(
                chatId
              )
            )
    
            && request.resource.data.workerId
              == currentMarketOrder(
                chatId
              ).workerId
          )
        )
    
        && (
          !(
            "sellerId"
            in request.resource.data
          )
    
          ||
    
          (
            (
              "sellerId"
              in currentMarketOrder(
                chatId
              )
            )
    
            && request.resource.data.sellerId
              == currentMarketOrder(
                chatId
              ).sellerId
          )
        )
    
        && request.resource.data.lastMessage
          is string
    
        && request.resource.data.lastMessage.size()
          > 0
    
        && request.resource.data.lastMessage.size()
          <= 1000
    
        && request.resource.data.lastMessageSenderId
          == request.auth.uid
    
        && request.resource.data.lastMessageSenderRole
          is string
    
        && request.resource.data.lastMessageSenderRole
          in [
            "customer",
            "worker",
            "seller"
          ]
    
        && (
          (
            request.resource.data.lastMessageSenderRole
              == "customer"
    
            && currentMarketOrder(
              chatId
            ).customerId
              == request.auth.uid
          )
    
          ||
    
          (
            request.resource.data.lastMessageSenderRole
              == "worker"
    
            && (
              "workerId"
              in currentMarketOrder(
                chatId
              )
            )
    
            && currentMarketOrder(
              chatId
            ).workerId
              == request.auth.uid
          )
    
          ||
    
          (
            request.resource.data.lastMessageSenderRole
              == "seller"
    
            && (
              "sellerId"
              in currentMarketOrder(
                chatId
              )
            )
    
            && currentMarketOrder(
              chatId
            ).sellerId
              == request.auth.uid
          )
        )
    
        && request.resource.data.updatedAt
          == request.time;
    
    
      /* ==========================================================
         READ CHAT
      ========================================================== */
    
      allow read:
        if signedIn()
    
        && (
          isMarketChatParticipant(
            chatId
          )
    
          ||
    
          isMarketChatOrderParticipant(
            chatId
          )
        );
    
    
      /* ==========================================================
         UPDATE CHAT SUMMARY
      ========================================================== */
    
      allow update:
        if signedIn()
    
        && marketOrderExists(
          resource.data.orderId
        )
    
        && isMarketOrderParticipant(
          resource.data.orderId
        )
    
        && request.resource.data.orderId
          == resource.data.orderId
    
        && resource.data.orderId
          == chatId
    
        && request.resource.data.customerId
          == resource.data.customerId
    
        && resource.data.customerId
          == currentMarketOrder(
            chatId
          ).customerId
    
        && (
          !(
            "workerId"
            in resource.data
          )
    
          ||
    
          (
            (
              "workerId"
              in request.resource.data
            )
    
            && request.resource.data.workerId
              == resource.data.workerId
          )
        )
    
        && (
          !(
            "sellerId"
            in resource.data
          )
    
          ||
    
          (
            (
              "sellerId"
              in request.resource.data
            )
    
            && request.resource.data.sellerId
              == resource.data.sellerId
          )
        )
    
        && request.resource.data.diff(
          resource.data
        ).affectedKeys().hasOnly([
          "updatedAt",
          "lastMessage",
          "lastMessageSenderId",
          "lastMessageSenderRole"
        ])
    
        && request.resource.data.lastMessage
          is string
    
        && request.resource.data.lastMessage.size()
          <= 1000
    
        && request.resource.data.updatedAt
          == request.time
    
        && request.resource.data.lastMessageSenderId
          == request.auth.uid
    
        && request.resource.data.lastMessageSenderRole
          in [
            "customer",
            "worker",
            "seller"
          ]
    
        && (
          (
            request.resource.data.lastMessageSenderRole
              == "customer"
    
            && currentMarketOrder(
              chatId
            ).customerId
              == request.auth.uid
          )
    
          ||
    
          (
            request.resource.data.lastMessageSenderRole
              == "worker"
    
            && (
              "workerId"
              in currentMarketOrder(
                chatId
              )
            )
    
            && currentMarketOrder(
              chatId
            ).workerId
              == request.auth.uid
          )
    
          ||
    
          (
            request.resource.data.lastMessageSenderRole
              == "seller"
    
            && (
              "sellerId"
              in currentMarketOrder(
                chatId
              )
            )
    
            && currentMarketOrder(
              chatId
            ).sellerId
              == request.auth.uid
          )
        );
    
    
      /* ==========================================================
         DELETE CHAT
    
         Chat documents are retained.
      ========================================================== */
    
      allow delete:
        if false;
    
    
      /* ==========================================================
         CHAT MESSAGES
      ========================================================== */
    
      match /messages/{messageId} {
    
        /* ========================================================
           READ MESSAGE
        ======================================================== */
    
        allow read:
          if signedIn()
    
          && (
            isMarketChatOrderParticipant(
              chatId
            )
    
            ||
    
            isMarketChatParticipant(
              chatId
            )
          );
    
    
        /* ========================================================
           CREATE MESSAGE
        ======================================================== */
    
        allow create:
          if signedIn()
    
          && marketOrderExists(
            chatId
          )
    
          && isMarketOrderParticipant(
            chatId
          )
    
          && request.resource.data.senderId
            == request.auth.uid
    
          && request.resource.data.senderRole
            is string
    
          && request.resource.data.senderRole
            in [
              "customer",
              "worker",
              "seller"
            ]
    
          && request.resource.data.text
            is string
    
          && request.resource.data.text.size()
            > 0
    
          && request.resource.data.text.size()
            <= 1000
    
          && request.resource.data.createdAt
            == request.time
    
          && request.resource.data.keys().hasOnly([
            "senderId",
            "senderRole",
            "text",
            "createdAt"
          ])
    
          && (
            (
              request.resource.data.senderRole
                == "customer"
    
              && currentMarketOrder(
                chatId
              ).customerId
                == request.auth.uid
            )
    
            ||
    
            (
              request.resource.data.senderRole
                == "worker"
    
              && (
                "workerId"
                in currentMarketOrder(
                  chatId
                )
              )
    
              && currentMarketOrder(
                chatId
              ).workerId
                == request.auth.uid
            )
    
            ||
    
            (
              request.resource.data.senderRole
                == "seller"
    
              && (
                "sellerId"
                in currentMarketOrder(
                  chatId
                )
              )
    
              && currentMarketOrder(
                chatId
              ).sellerId
                == request.auth.uid
            )
          );
    
    
        /* ========================================================
           UPDATE MESSAGE
    
           Sent messages are immutable.
        ======================================================== */
    
        allow update:
          if false;
    
    
        /* ========================================================
           DELETE OWN MESSAGE
        ======================================================== */
    
        allow delete:
          if signedIn()
    
          && marketOrderExists(
            chatId
          )
    
          && isMarketOrderParticipant(
            chatId
          )
    
          && resource.data.senderId
            == request.auth.uid;
      }
    }

    /* ============================================================
       SOURCE: firestore/rules/06-calls.rules
    ============================================================ */

    match /calls/{callId} {
    
      // ============================================================
      // CUSTOMER -> WORKER
      // Customer starts a direct call to a worker.
      // ============================================================
      allow create:
        if signedIn()
        && request.resource.data.keys().hasAll([
          "callerId",
          "callerRole",
          "calleeId",
          "calleeRole",
          "callerSnapshot",
          "calleeSnapshot",
          "status",
          "createdAt",
          "acceptedAt",
          "connectedAt",
          "endedAt",
          "endedBy"
        ])
        && request.resource.data.keys().hasOnly([
          "callerId",
          "callerRole",
          "calleeId",
          "calleeRole",
          "callerSnapshot",
          "calleeSnapshot",
          "status",
          "createdAt",
          "acceptedAt",
          "connectedAt",
          "endedAt",
          "endedBy"
        ])
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.callerRole == "customer"
        && request.resource.data.calleeId is string
        && request.resource.data.calleeId.size() > 0
        && request.resource.data.calleeId.size() <= 128
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.calleeRole == "worker"
        && workerProfileExists(request.resource.data.calleeId)
        && request.resource.data.status == "ringing"
        && request.resource.data.createdAt == request.time
        && request.resource.data.acceptedAt == null
        && request.resource.data.connectedAt == null
        && request.resource.data.endedAt == null
        && request.resource.data.endedBy == null
        && validCallSnapshot(request.resource.data.callerSnapshot)
        && validCallSnapshot(request.resource.data.calleeSnapshot);
    
    
      // ============================================================
      // WORKER -> CUSTOMER CALLBACK
      //
      // Worker can only call a customer who already exists inside:
      //
      // workerContacts/{workerId}/customers/{customerId}
      //
      // This prevents a worker from using this rule to call arbitrary
      // customer IDs.
      // ============================================================
      allow create:
        if signedIn()
        && request.resource.data.keys().hasAll([
          "callerId",
          "callerRole",
          "calleeId",
          "calleeRole",
          "callerSnapshot",
          "calleeSnapshot",
          "status",
          "createdAt",
          "acceptedAt",
          "connectedAt",
          "endedAt",
          "endedBy"
        ])
        && request.resource.data.keys().hasOnly([
          "callerId",
          "callerRole",
          "calleeId",
          "calleeRole",
          "callerSnapshot",
          "calleeSnapshot",
          "status",
          "createdAt",
          "acceptedAt",
          "connectedAt",
          "endedAt",
          "endedBy"
        ])
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.callerRole == "worker"
        && request.resource.data.calleeId is string
        && request.resource.data.calleeId.size() > 0
        && request.resource.data.calleeId.size() <= 128
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.calleeRole == "customer"
        && workerProfileExists(request.auth.uid)
        && workerContactExists(request.auth.uid, request.resource.data.calleeId)
        && request.resource.data.status == "ringing"
        && request.resource.data.createdAt == request.time
        && request.resource.data.acceptedAt == null
        && request.resource.data.connectedAt == null
        && request.resource.data.endedAt == null
        && request.resource.data.endedBy == null
        && validCallSnapshot(request.resource.data.callerSnapshot)
        && validCallSnapshot(request.resource.data.calleeSnapshot);
    
    
      // ============================================================
      // WORKER -> CUSTOMER
      // MARKET / ORDER CALL
      // ============================================================
      allow create:
        if validWorkerMarketCallCreate();
    
    
      // ============================================================
      // WORKER -> CUSTOMER
      // SHOP REQUEST CALL
      // ============================================================
      allow create:
        if validWorkerShopRequestCallCreate();
    
    
      // ============================================================
      // READ
      //
      // Only caller or callee can read the call document.
      // ============================================================
      allow read:
        if isCallParticipant(resource.data);
    
    
      // ============================================================
      // ACCEPT CALL
      //
      // Only the callee can accept a ringing call.
      // ============================================================
      allow update:
        if (
          signedIn()
          && resource.data.status == "ringing"
          && resource.data.calleeId == request.auth.uid
          && request.resource.data.status == "accepted"
          && request.resource.data.acceptedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status",
            "acceptedAt"
          ])
        );
    
    
      // ============================================================
      // DECLINE CALL
      //
      // Only the callee can decline a ringing call.
      // ============================================================
      allow update:
        if (
          signedIn()
          && resource.data.status == "ringing"
          && resource.data.calleeId == request.auth.uid
          && request.resource.data.status == "declined"
          && request.resource.data.endedAt == request.time
          && request.resource.data.endedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status",
            "endedAt",
            "endedBy"
          ])
        );
    
    
      // ============================================================
      // CONNECT CALL
      //
      // Caller or callee can transition an accepted call to connected.
      // ============================================================
      allow update:
        if (
          isCallParticipant(resource.data)
          && resource.data.status == "accepted"
          && request.resource.data.status == "connected"
          && request.resource.data.connectedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status",
            "connectedAt"
          ])
        );
    
    
      // ============================================================
      // END CALL
      //
      // Either participant can end a ringing, accepted or connected
      // call.
      // ============================================================
      allow update:
        if (
          isCallParticipant(resource.data)
          && resource.data.status in [
            "ringing",
            "accepted",
            "connected"
          ]
          && request.resource.data.status == "ended"
          && request.resource.data.endedAt == request.time
          && request.resource.data.endedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status",
            "endedAt",
            "endedBy"
          ])
        );
    
    
      // ============================================================
      // DELETE
      //
      // Calls are immutable records and cannot be deleted by clients.
      // ============================================================
      allow delete:
        if false;
    }

    /* ============================================================
       SOURCE: firestore/rules/08-shops.rules
    ============================================================ */

    /* ============================================================
       SHOP HELPERS
    
       Shared helpers from 01-core.rules:
    
       signedIn()
       isOwner(uid)
    ============================================================ */
    
    function validShopCategory(value) {
      return value is string
        && value in [
          "plumbing",
          "electrical-repair",
          "phone-repair",
          "car-repair",
          "ac-repair",
