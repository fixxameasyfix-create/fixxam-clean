          "house-wiring",
          "electrical-installation",
          "inverter-installation",
          "inverter-repair",
          "solar-repair",
          "solar-battery-service",
          "generator-installation",
    
          "pipe-repair",
          "drain-unblocking",
          "toilet-repair",
          "water-pump-repair",
          "borehole-service",
          "water-tank-installation",
          "ac-installation",
          "ac-servicing",
