rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ============================================================
       GENERAL HELPERS
    ============================================================ */

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn()
        && request.auth.uid == uid;
    }

    function workerProfileExists(workerId) {
      return exists(
        /databases/$(database)/documents/workerPublicProfiles/$(workerId)
      );
    }


    /* ============================================================
       BOOKING HELPERS
    ============================================================ */

    function bookingExists(bookingId) {
      return exists(
        /databases/$(database)/documents/bookings/$(bookingId)
      );
    }

    function currentBooking(bookingId) {
      return get(
        /databases/$(database)/documents/bookings/$(bookingId)
      ).data;
    }

    function isBookingCustomer(bookingId) {
      return signedIn()
        && bookingExists(bookingId)
        && currentBooking(bookingId).customerId
          == request.auth.uid;
    }

    function isBookingWorker(bookingId) {
      return signedIn()
        && bookingExists(bookingId)
        && currentBooking(bookingId).workerId
          == request.auth.uid;
    }

    function validOfferAmount(value) {
      return value is number
        && value > 0
        && value <= 100000000;
    }

    function validOfferMessage(value) {
      return value == null
        || (
          value is string
          && value.size() <= 300
        );
    }

    function validOfferExpiry(value) {
      return value is timestamp
        && value > request.time;
    }


    /* ============================================================
       MARKET ORDER HELPERS
    ============================================================ */

    function marketOrderExists(orderId) {
      return exists(
        /databases/$(database)/documents/orders/$(orderId)
      );
    }

    function currentMarketOrder(orderId) {
      return get(
        /databases/$(database)/documents/orders/$(orderId)
      ).data;
    }

    function isMarketOrderCustomer(orderId) {
      return signedIn()
        && marketOrderExists(orderId)
        && currentMarketOrder(orderId).customerId
          == request.auth.uid;
    }

    function isMarketOrderWorker(orderId) {
      return signedIn()
        && marketOrderExists(orderId)
        && currentMarketOrder(orderId).workerId
          == request.auth.uid;
    }

    function isMarketOrderSeller(orderId) {
      return signedIn()
        && marketOrderExists(orderId)
        && currentMarketOrder(orderId).sellerId
          == request.auth.uid;
    }

    function isMarketOrderParticipant(orderId) {
      return isMarketOrderCustomer(orderId)
        || isMarketOrderWorker(orderId)
        || isMarketOrderSeller(orderId);
    }


    /* ============================================================
       MARKET CHAT HELPERS
    ============================================================ */

    function marketChatExists(chatId) {
      return exists(
        /databases/$(database)/documents/marketChats/$(chatId)
      );
    }

    function currentMarketChat(chatId) {
      return get(
        /databases/$(database)/documents/marketChats/$(chatId)
      ).data;
    }

    function isMarketChatParticipant(chatId) {
      return signedIn()
        && marketChatExists(chatId)
        && (
          (
            "customerId" in currentMarketChat(chatId)
            &&
            currentMarketChat(chatId).customerId
              == request.auth.uid
          )
          ||
          (
            "workerId" in currentMarketChat(chatId)
            &&
            currentMarketChat(chatId).workerId
              == request.auth.uid
          )
          ||
          (
            "sellerId" in currentMarketChat(chatId)
            &&
            currentMarketChat(chatId).sellerId
              == request.auth.uid
          )
        );
    }

    function isMarketChatOrderParticipant(chatId) {
      return signedIn()
        && marketOrderExists(chatId)
        && isMarketOrderParticipant(chatId);
    }


    /* ============================================================
       USERS
    ============================================================ */

    match /users/{userId} {

      allow create:
        if isOwner(userId);

      allow read:
        if isOwner(userId);

      allow update:
        if isOwner(userId);

      allow delete:
        if false;


      match /notifications/{notificationId} {

        allow read:
          if signedIn()
          && request.auth.uid == userId;

        /*
         * Notifications are created by Cloud Functions/Admin SDK.
         */
        allow create:
          if false;

        /*
         * Client can only change "read".
         */
        allow update:
          if signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(
            resource.data
          ).affectedKeys().hasOnly([
            "read"
          ])
          && request.resource.data.read is bool;

        allow delete:
          if false;
      }
    }


    /* ============================================================
       WORKER PUBLIC PROFILES
    ============================================================ */

    match /workerPublicProfiles/{workerId} {

      allow read:
        if true;

      allow create:
        if isOwner(workerId);

      allow update:
        if isOwner(workerId);

      allow delete:
        if false;
    }


    /* ============================================================
       CATEGORIES
    ============================================================ */

    match /categories/{categoryId} {

      allow read:
        if true;

      allow create, update, delete:
        if signedIn();
    }


    /* ============================================================
       SUBCATEGORIES
    ============================================================ */

    match /subcategories/{subcategoryId} {

      allow read:
        if true;

      allow create, update, delete:
        if signedIn();
    }


    /* ============================================================
       SERVICES
    ============================================================ */

    match /services/{serviceId} {

      allow read:
        if true;

      allow create, update, delete:
        if signedIn();
    }


    /* ============================================================
       PRODUCTS
    ============================================================ */

    match /products/{productId} {

      /*
       * Customers and workers can browse products.
       */
      allow read:
        if true;


      /* ----------------------------------------------------------
         CREATE
      ---------------------------------------------------------- */

      allow create:
        if signedIn()

        /*
         * Product owner MUST be the authenticated user.
         */
        && request.resource.data.workerId
          == request.auth.uid

        /*
         * The authenticated user MUST have a
         * worker public profile.
         */
        && workerProfileExists(
          request.auth.uid
        )

        /*
         * Basic required product fields.
         */
        && request.resource.data.name
          is string

        && request.resource.data.name.size()
          > 0

        && request.resource.data.name.size()
          <= 200

        && request.resource.data.category
          is string

        && request.resource.data.category.size()
          > 0

        && request.resource.data.price
          is number

        && request.resource.data.price
          > 0

        && request.resource.data.stock
          is number

        && request.resource.data.stock
          >= 0;
      

      /* ----------------------------------------------------------
         UPDATE
      ---------------------------------------------------------- */

      allow update:
        if signedIn()

        /*
         * Only the product owner can update.
         */
        && resource.data.workerId
          == request.auth.uid

        /*
         * Ownership cannot be transferred.
         */
        && request.resource.data.workerId
          == resource.data.workerId

        /*
         * Basic validation.
         */
        && request.resource.data.name
          is string

        && request.resource.data.name.size()
          > 0

        && request.resource.data.name.size()
          <= 200

        && request.resource.data.category
          is string

        && request.resource.data.category.size()
          > 0

        && request.resource.data.price
          is number

        && request.resource.data.price
          > 0

        && request.resource.data.stock
          is number

        && request.resource.data.stock
          >= 0;


      /* ----------------------------------------------------------
         DELETE
      ---------------------------------------------------------- */

      allow delete:
        if signedIn()
        && resource.data.workerId
          == request.auth.uid;
    }


    /* ============================================================
       PRODUCT DEALS
    ============================================================ */

    match /deals/{dealId} {

      /*
       * Customers need to read active deals.
       */
      allow read:
        if true;


      /* ----------------------------------------------------------
         CREATE
      ---------------------------------------------------------- */

      allow create:
        if signedIn()

        /*
         * Deal worker must be current authenticated worker.
         */
        && request.resource.data.workerId
          == request.auth.uid

        /*
         * Product must exist.
         */
        && exists(
          /databases/$(database)/documents/products/$(request.resource.data.productId)
        )

        /*
         * Deal worker must own the product.
         */
        && get(
          /databases/$(database)/documents/products/$(request.resource.data.productId)
        ).data.workerId
          == request.auth.uid

        /*
         * Required deal fields.
         */
        && request.resource.data.productId
          is string

        && request.resource.data.productId.size()
          > 0

        && request.resource.data.originalPrice
          is number

        && request.resource.data.originalPrice
          > 0

        && request.resource.data.discountedPrice
          is number

        && request.resource.data.discountedPrice
          > 0

        && request.resource.data.discountedPrice
          < request.resource.data.originalPrice

        && request.resource.data.discountPercentage
          is number

        && request.resource.data.discountPercentage
          > 0

        && request.resource.data.discountPercentage
          < 100

        && request.resource.data.startsAt
          is timestamp

        && request.resource.data.expiresAt
          is timestamp

        && request.resource.data.expiresAt
          > request.resource.data.startsAt;


      /* ----------------------------------------------------------
         UPDATE
      ---------------------------------------------------------- */

      allow update:
        if signedIn()

        && resource.data.workerId
          == request.auth.uid

        /*
         * Deal ownership cannot change.
         */
        && request.resource.data.workerId
          == resource.data.workerId

        && request.resource.data.productId
          == resource.data.productId;


      /* ----------------------------------------------------------
         DELETE
      ---------------------------------------------------------- */

      allow delete:
        if signedIn()
        && resource.data.workerId
          == request.auth.uid;
    }


    /* ============================================================
       SERVICE BOOKINGS
    ============================================================ */

    match /bookings/{bookingId} {

      allow read:
        if signedIn()
        && (
          resource.data.customerId
            == request.auth.uid
          ||
          resource.data.workerId
            == request.auth.uid
        );


      /* ==========================================================
         CREATE
      ========================================================== */

      allow create:
        if signedIn()

        && request.resource.data.customerId
          == request.auth.uid

        && request.resource.data.status
          == "pending"

        && request.resource.data.offerStatus
          == "none"

        && request.resource.data.offerAmount
          == null

        && request.resource.data.agreedPrice
          == null

        && request.resource.data.counterOfferAmount
          == null

        && request.resource.data.counterOfferStatus
          == "none"

        && request.resource.data.negotiationStatus
          == "none"

        && request.resource.data.offerRound
          == 0

        && (
          !("offerMessage" in request.resource.data)
          ||
          request.resource.data.offerMessage == null
        )

        && (
          !("offerExpiresAt" in request.resource.data)
          ||
          request.resource.data.offerExpiresAt == null
        )

        && (
          !("offerSentAt" in request.resource.data)
          ||
          request.resource.data.offerSentAt == null
        )

        && (
          !("offerRespondedAt" in request.resource.data)
          ||
          request.resource.data.offerRespondedAt == null
        )

        && (
          !("offerWorkerId" in request.resource.data)
          ||
          request.resource.data.offerWorkerId == null
        )

        && (
          !("counterOfferMessage" in request.resource.data)
          ||
          request.resource.data.counterOfferMessage == null
        )

        && (
          !("counterOfferSentAt" in request.resource.data)
          ||
          request.resource.data.counterOfferSentAt == null
        )

        && (
          !("counterOfferRespondedAt" in request.resource.data)
          ||
          request.resource.data.counterOfferRespondedAt == null
        )

        && (
          !("counterOfferBy" in request.resource.data)
          ||
          request.resource.data.counterOfferBy == null
        );


      allow delete:
        if false;


      /* ==========================================================
         UPDATE
      ========================================================== */

      allow update:
        if signedIn()
        && bookingExists(bookingId)
        && (

          /* ======================================================
             CUSTOMER ACTIONS
          ====================================================== */

          (
            isBookingCustomer(bookingId)
            && (

              /* CUSTOMER ACCEPTS WORKER OFFER */

              (
                resource.data.status
                  == "pending"

                && resource.data.offerStatus
                  == "sent"

                && request.resource.data.status
                  == "accepted"

                && request.resource.data.offerStatus
                  == "accepted"

                && request.resource.data.agreedPrice
                  == resource.data.offerAmount

                && request.resource.data.amount
                  == resource.data.offerAmount

                && request.resource.data.offerAmount
                  == resource.data.offerAmount

                && request.resource.data.customerId
                  == resource.data.customerId

                && request.resource.data.workerId
                  == resource.data.workerId

                && request.resource.data.offerWorkerId
                  == resource.data.offerWorkerId

                && request.resource.data.diff(
                  resource.data
                ).affectedKeys().hasOnly([
                  "status",
                  "offerStatus",
                  "agreedPrice",
                  "amount",
                  "updatedAt"
                ])
              )

              ||

              /* CUSTOMER COUNTER OFFER */

              (
                resource.data.status
                  == "pending"

                && resource.data.offerStatus
                  == "sent"

                && resource.data.offerRound
                  == 1

                && resource.data.counterOfferBy
                  == null

                && request.resource.data.status
                  == "pending"

                && request.resource.data.offerStatus
                  == "countered"

                && request.resource.data.customerId
                  == resource.data.customerId

                && request.resource.data.workerId
                  == resource.data.workerId

                && request.resource.data.offerAmount
                  == resource.data.offerAmount

                && request.resource.data.offerMessage
                  == resource.data.offerMessage

                && request.resource.data.offerWorkerId
                  == resource.data.offerWorkerId

                && request.resource.data.counterOfferBy
                  == "customer"

                && request.resource.data.counterOfferStatus
                  == "sent"

                && validOfferAmount(
                  request.resource.data.counterOfferAmount
                )

                && validOfferMessage(
                  request.resource.data.counterOfferMessage
                )

                && request.resource.data.agreedPrice
                  == resource.data.agreedPrice

                && request.resource.data.negotiationStatus
                  == "negotiating"

                && request.resource.data.offerRound
                  == 2

                && request.resource.data.diff(
                  resource.data
                ).affectedKeys().hasOnly([
                  "counterOfferAmount",
                  "counterOfferMessage",
                  "counterOfferSentAt",
                  "counterOfferRespondedAt",
                  "counterOfferBy",
                  "counterOfferStatus",
                  "negotiationStatus",
                  "offerRound",
                  "offerStatus",
                  "updatedAt"
                ])
              )

              ||

              /* CUSTOMER DECLINES WORKER OFFER */

              (
                resource.data.status
                  == "pending"

                && resource.data.offerStatus
                  == "sent"

                && request.resource.data.status
                  == "cancelled"

                && request.resource.data.offerStatus
                  == "declined"

                && request.resource.data.cancelledBy
                  == "customer"

                && request.resource.data.customerId
                  == resource.data.customerId

                && request.resource.data.workerId
                  == resource.data.workerId

                && request.resource.data.diff(
                  resource.data
                ).affectedKeys().hasOnly([
                  "status",
                  "offerStatus",
                  "cancelledBy",
                  "updatedAt"
                ])
              )

              ||

              /* CUSTOMER ACCEPTS WORKER COUNTER */

              (
                resource.data.status
                  == "pending"

                && resource.data.counterOfferStatus
                  == "sent"

                && resource.data.counterOfferBy
                  == "worker"

                && request.resource.data.status
                  == "accepted"

                && request.resource.data.offerStatus
                  == "accepted"

                && request.resource.data.counterOfferStatus
                  == "accepted"

                && request.resource.data.agreedPrice
                  == resource.data.counterOfferAmount

                && request.resource.data.amount
                  == resource.data.counterOfferAmount

                && request.resource.data.customerId
                  == resource.data.customerId

                && request.resource.data.workerId
                  == resource.data.workerId

                && request.resource.data.diff(
                  resource.data
                ).affectedKeys().hasOnly([
                  "status",
                  "offerStatus",
                  "counterOfferStatus",
                  "agreedPrice",
                  "amount",
                  "updatedAt"
                ])
              )

              ||

              /* CUSTOMER DECLINES WORKER COUNTER */

              (
                resource.data.status
                  == "pending"

                && resource.data.counterOfferStatus
                  == "sent"

                && resource.data.counterOfferBy
                  == "worker"

                && request.resource.data.status
                  == "cancelled"

                && request.resource.data.offerStatus
                  == "countered"

                && request.resource.data.counterOfferStatus
                  == "declined"

                && request.resource.data.cancelledBy
                  == "customer"

                && request.resource.data.customerId
                  == resource.data.customerId

                && request.resource.data.workerId
                  == resource.data.workerId

                && request.resource.data.diff(
                  resource.data
                ).affectedKeys().hasOnly([
                  "status",
                  "counterOfferStatus",
                  "cancelledBy",
                  "updatedAt"
                ])
              )
            )
          )


          ||

          /* ======================================================
             WORKER ACTIONS
          ====================================================== */

          (
            isBookingWorker(bookingId)
            && (

              /* WORKER INITIAL OFFER */

              (
                resource.data.status
                  == "pending"

                && resource.data.offerStatus
                  == "none"

                && resource.data.offerRound
                  == 0

                && request.resource.data.status
                  == "pending"

                && request.resource.data.offerStatus
                  == "sent"

                && resource.data.workerId
                  == request.auth.uid

                && request.resource.data.workerId
                  == resource.data.workerId

                && request.resource.data.customerId
                  == resource.data.customerId

                && validOfferAmount(
                  request.resource.data.offerAmount
                )

                && validOfferMessage(
                  request.resource.data.offerMessage
                )

                && request.resource.data.offerWorkerId
                  == request.auth.uid

                && request.resource.data.negotiationStatus
                  == "negotiating"

                && request.resource.data.offerRound
                  == 1

                && request.resource.data.counterOfferAmount
                  == null

                && request.resource.data.counterOfferMessage
                  == null

                && request.resource.data.counterOfferSentAt
                  == null

                && request.resource.data.counterOfferRespondedAt
                  == null

                && request.resource.data.counterOfferBy
                  == null

                && request.resource.data.counterOfferStatus
                  == "none"

                && request.resource.data.agreedPrice
                  == resource.data.agreedPrice

                && request.resource.data.offerRespondedAt
                  == null

                && request.resource.data.offerSentAt
                  == request.time

                && request.resource.data.updatedAt
                  == request.time

                && validOfferExpiry(
                  request.resource.data.offerExpiresAt
                )

                && request.resource.data.diff(
                  resource.data
                ).affectedKeys().hasOnly([
                  "offerStatus",
                  "offerAmount",
                  "offerMessage",
                  "offerExpiresAt",
                  "offerSentAt",
                  "offerRespondedAt",
                  "offerWorkerId",
                  "counterOfferAmount",
                  "counterOfferMessage",
                  "counterOfferSentAt",
                  "counterOfferRespondedAt",
                  "counterOfferBy",
                  "counterOfferStatus",
                  "negotiationStatus",
                  "offerRound",
                  "updatedAt"
                ])
              )

              ||

              /* WORKER ACCEPTS CUSTOMER COUNTER */

              (
                resource.data.status
                  == "pending"

                && resource.data.counterOfferStatus
                  == "sent"

                && resource.data.counterOfferBy
                  == "customer"

                && request.resource.data.status
                  == "accepted"

                && request.resource.data.offerStatus
                  == "accepted"

                && request.resource.data.counterOfferStatus
                  == "accepted"

                && request.resource.data.agreedPrice
                  == resource.data.counterOfferAmount

                && request.resource.data.amount
                  == resource.data.counterOfferAmount

                && request.resource.data.customerId
                  == resource.data.customerId

                && request.resource.data.workerId
                  == resource.data.workerId

                && request.resource.data.diff(
                  resource.data
                ).affectedKeys().hasOnly([
                  "status",
                  "offerStatus",
                  "counterOfferStatus",
                  "agreedPrice",
                  "amount",
                  "updatedAt"
                ])
              )

              ||

              /* WORKER COUNTER OFFER */

              (
                resource.data.status
                  == "pending"

                && resource.data.counterOfferStatus
                  == "sent"

                && resource.data.counterOfferBy
                  == "customer"

                && resource.data.offerRound
                  == 2

                && request.resource.data.status
                  == "pending"

                && request.resource.data.offerStatus
                  == "countered"

                && request.resource.data.counterOfferBy
                  == "worker"

                && request.resource.data.counterOfferStatus
                  == "sent"

                && validOfferAmount(
                  request.resource.data.counterOfferAmount
                )

                && validOfferMessage(
                  request.resource.data.counterOfferMessage
                )

                && request.resource.data.customerId
                  == resource.data.customerId

                && request.resource.data.workerId
                  == request.auth.uid

                && request.resource.data.offerWorkerId
                  == resource.data.offerWorkerId

                && request.resource.data.agreedPrice
                  == resource.data.agreedPrice

                && request.resource.data.negotiationStatus
                  == "negotiating"

                && request.resource.data.offerRound
                  == 3

                && request.resource.data.diff(
                  resource.data
                ).affectedKeys().hasOnly([
                  "counterOfferAmount",
                  "counterOfferMessage",
                  "counterOfferSentAt",
                  "counterOfferRespondedAt",
                  "counterOfferBy",
                  "counterOfferStatus",
                  "negotiationStatus",
                  "offerRound",
                  "offerStatus",
                  "updatedAt"
                ])
              )

              ||

              /* WORKER DECLINES CUSTOMER COUNTER */

              (
                resource.data.status
                  == "pending"

                && resource.data.counterOfferStatus
                  == "sent"

                && resource.data.counterOfferBy
                  == "customer"

                && request.resource.data.status
                  == "cancelled"

                && request.resource.data.offerStatus
                  == "countered"

                && request.resource.data.counterOfferStatus
                  == "declined"

                && request.resource.data.cancelledBy
                  == "worker"

                && request.resource.data.customerId
                  == resource.data.customerId

                && request.resource.data.workerId
                  == resource.data.workerId

                && request.resource.data.diff(
                  resource.data
                ).affectedKeys().hasOnly([
                  "status",
                  "counterOfferStatus",
                  "cancelledBy",
                  "updatedAt"
                ])
              )
            )
          )


          ||

          /* WORKER STARTS SERVICE */

          (
            isBookingWorker(bookingId)

            && resource.data.status
              == "accepted"

            && request.resource.data.status
              == "in-progress"

            && request.resource.data.agreedPrice
              == resource.data.agreedPrice

            && request.resource.data.customerId
              == resource.data.customerId

            && request.resource.data.workerId
              == resource.data.workerId

            && request.resource.data.diff(
              resource.data
            ).affectedKeys().hasOnly([
              "status",
              "updatedAt"
            ])
          )


          ||

          /* WORKER COMPLETES SERVICE */

          (
            isBookingWorker(bookingId)

            && resource.data.status
              == "in-progress"

            && request.resource.data.status
              == "completed"

            && request.resource.data.agreedPrice
              == resource.data.agreedPrice

            && request.resource.data.customerId
              == resource.data.customerId

            && request.resource.data.workerId
              == resource.data.workerId

            && request.resource.data.diff(
              resource.data
            ).affectedKeys().hasOnly([
              "status",
              "updatedAt"
            ])
          )
        );
    }


    /* ============================================================
       MARKET ORDERS
    ============================================================ */

    match /orders/{orderId} {

      allow read:
        if signedIn()
        && (
          resource.data.customerId
            == request.auth.uid
          ||
          resource.data.workerId
            == request.auth.uid
          ||
          resource.data.sellerId
            == request.auth.uid
        );


      allow create:
        if signedIn()

        && (
          request.resource.data.customerId
            == request.auth.uid
          ||
          request.resource.data.workerId
            == request.auth.uid
          ||
          request.resource.data.sellerId
            == request.auth.uid
        )

        /*
         * Customer cannot assign an order to themselves.
         */
        && request.resource.data.customerId
          != request.resource.data.workerId;


      allow update:
        if signedIn()

        && (
          resource.data.customerId
            == request.auth.uid
          ||
          resource.data.workerId
            == request.auth.uid
          ||
          resource.data.sellerId
            == request.auth.uid
        )

        && request.resource.data.customerId
          == resource.data.customerId

        && request.resource.data.workerId
          == resource.data.workerId

        && request.resource.data.sellerId
          == resource.data.sellerId;


      allow delete:
        if false;
    }


    /* ============================================================
       MARKET CHATS
    ============================================================ */

    match /marketChats/{chatId} {

      allow create:
        if signedIn()

        && request.resource.data.orderId
          is string

        && request.resource.data.orderId
          != ""

        && marketOrderExists(
          request.resource.data.orderId
        )

        && isMarketOrderParticipant(
          request.resource.data.orderId
        )

        && request.resource.data.customerId
          == currentMarketOrder(
            request.resource.data.orderId
          ).customerId

        && (
          !("workerId" in request.resource.data)
          ||
          (
            "workerId" in currentMarketOrder(
              request.resource.data.orderId
            )
            &&
            request.resource.data.workerId
              == currentMarketOrder(
                request.resource.data.orderId
              ).workerId
          )
        )

        && (
          !("sellerId" in request.resource.data)
          ||
          (
            "sellerId" in currentMarketOrder(
              request.resource.data.orderId
            )
            &&
            request.resource.data.sellerId
              == currentMarketOrder(
                request.resource.data.orderId
              ).sellerId
          )
        );


      allow read:
        if isMarketChatParticipant(chatId)
        || isMarketChatOrderParticipant(chatId);


      allow update:
        if isMarketChatParticipant(chatId)

        && request.resource.data.orderId
          == resource.data.orderId

        && request.resource.data.customerId
          == resource.data.customerId

        && (
          !("workerId" in resource.data)
          ||
          (
            "workerId" in request.resource.data
            &&
            request.resource.data.workerId
              == resource.data.workerId
          )
        )

        && (
          !("sellerId" in resource.data)
          ||
          (
            "sellerId" in request.resource.data
            &&
            request.resource.data.sellerId
              == resource.data.sellerId
          )
        )

        && request.resource.data.diff(
          resource.data
        ).affectedKeys().hasOnly([
          "updatedAt",
          "lastMessage",
          "lastMessageSenderId",
          "lastMessageSenderRole"
        ])

        && request.resource.data.lastMessageSenderId
          == request.auth.uid

        && (
          (
            request.resource.data.lastMessageSenderRole
              == "customer"

            && resource.data.customerId
              == request.auth.uid
          )

          ||

          (
            request.resource.data.lastMessageSenderRole
              == "worker"

            && resource.data.workerId
              == request.auth.uid
          )

          ||

          (
            request.resource.data.lastMessageSenderRole
              == "seller"

            && resource.data.sellerId
              == request.auth.uid
          )
        );


      allow delete:
        if false;


      /* ==========================================================
         MARKET CHAT MESSAGES
      ========================================================== */

      match /messages/{messageId} {

        allow read:
          if isMarketChatOrderParticipant(chatId)
          || isMarketChatParticipant(chatId);


        allow create:
          if signedIn()

          && (
            isMarketChatOrderParticipant(chatId)
            || isMarketChatParticipant(chatId)
          )

          && request.resource.data.senderId
            == request.auth.uid

          && request.resource.data.text
            is string

          && request.resource.data.text.size()
            > 0

          && request.resource.data.text.size()
            <= 1000

          && request.resource.data.senderRole
            in [
              "customer",
              "worker",
              "seller"
            ]

          && (

            /* CUSTOMER */

            (
              request.resource.data.senderRole
                == "customer"

              && (
                (
                  marketOrderExists(chatId)

                  && currentMarketOrder(chatId).customerId
                    == request.auth.uid
                )

                ||

                (
                  marketChatExists(chatId)

                  && "customerId"
                    in currentMarketChat(chatId)

                  && currentMarketChat(chatId).customerId
                    == request.auth.uid
                )
              )
            )

            ||

            /* WORKER */

            (
              request.resource.data.senderRole
                == "worker"

              && (
                (
                  marketOrderExists(chatId)

                  && "workerId"
                    in currentMarketOrder(chatId)

                  && currentMarketOrder(chatId).workerId
                    == request.auth.uid
                )

                ||

                (
                  marketChatExists(chatId)

                  && "workerId"
                    in currentMarketChat(chatId)

                  && currentMarketChat(chatId).workerId
                    == request.auth.uid
                )
              )
            )

            ||

            /* SELLER */

            (
              request.resource.data.senderRole
                == "seller"

              && (
                (
                  marketOrderExists(chatId)

                  && "sellerId"
                    in currentMarketOrder(chatId)

                  && currentMarketOrder(chatId).sellerId
                    == request.auth.uid
                )

                ||

                (
                  marketChatExists(chatId)

                  && "sellerId"
                    in currentMarketChat(chatId)

                  && currentMarketChat(chatId).sellerId
                    == request.auth.uid
                )
              )
            )
          )

          && request.resource.data.createdAt
            == request.time;


        allow update:
          if false;


        allow delete:
          if signedIn()

          && (
            isMarketChatOrderParticipant(chatId)
            || isMarketChatParticipant(chatId)
          )

          && resource.data.senderId
            == request.auth.uid;
      }
    }


    /* ============================================================
       FAVORITES
    ============================================================ */

    match /favorites/{favoriteId} {

      allow read, write:
        if signedIn();
    }


    /* ============================================================
       RECENTLY VIEWED
    ============================================================ */

    match /recentlyViewed/{documentId} {

      allow read, write:
        if signedIn();
    }


    /* ============================================================
       DEFAULT DENY
    ============================================================ */

    match /{document=**} {

      allow read, write:
        if false;
    }
  }
}