    function validShopCoordinate(latitude, longitude) {
      return latitude is number
        && latitude >= -90
        && latitude <= 90
        && longitude is number
        && longitude >= -180
        && longitude <= 180;
    }
    
    function validShopHttpsUrl(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 2048
        && value.matches("^https://.*");
    }
    
    /* ============================================================
       BUSINESS HOURS
    ============================================================ */
    
    function validShopBusinessHourShape(value) {
      return value is map
        && value.keys().hasOnly([
          "id",
          "day",
          "isOpen",
          "openTime",
          "closeTime"
        ]);
    }
    
    function validShopBusinessHours(hours) {
      return hours is list
        && hours.size() >= 1
        && hours.size() <= 7
    
        && validShopBusinessHourShape(hours[0])
    
        && (
          hours.size() < 2
          || validShopBusinessHourShape(hours[1])
        )
    
        && (
          hours.size() < 3
          || validShopBusinessHourShape(hours[2])
        )
    
        && (
          hours.size() < 4
          || validShopBusinessHourShape(hours[3])
        )
    
        && (
          hours.size() < 5
          || validShopBusinessHourShape(hours[4])
        )
    
        && (
          hours.size() < 6
          || validShopBusinessHourShape(hours[5])
        )
    
        && (
          hours.size() < 7
          || validShopBusinessHourShape(hours[6])
        );
    }
    
    /* ============================================================
       SHOP DOCUMENT
    ============================================================ */
    
    function validShopDocument(data) {
      return data.ownerId is string
        && data.ownerId.size() > 0
        && data.ownerId.size() <= 128
    
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 100
    
        && validShopCategory(data.category)
    
        && data.description is string
        && data.description.size() >= 1
        && data.description.size() <= 500
    
        && data.phone is string
        && data.phone.size() >= 7
        && data.phone.size() <= 30
    
        && data.address is string
        && data.address.size() >= 3
        && data.address.size() <= 300
    
        && validShopCoordinate(
          data.latitude,
          data.longitude
        )
    
        && validShopHttpsUrl(data.coverPhotoUrl)
        && validShopHttpsUrl(data.logoUrl)
    
        && validShopBusinessHours(data.businessHours)
    
        && data.isActive is bool
    
        && data.rating is number
        && data.rating >= 0
        && data.rating <= 5
    
        && data.reviewCount is number
        && data.reviewCount >= 0
    
        && data.serviceCount is number
        && data.serviceCount >= 0
        && data.serviceCount <= 30
    
        && (
          data.minimumStartingPrice == null
          || (
            data.minimumStartingPrice is number
            && data.minimumStartingPrice > 0
            && data.minimumStartingPrice <= 100000000
          )
        )
    
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }
    
    /* ============================================================
       SHOP SERVICE
    ============================================================ */
    
    function validShopService(data, serviceId) {
      return data.id is string
        && data.id == serviceId
    
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 100
    
        && data.description is string
        && data.description.size() >= 1
        && data.description.size() <= 1000
    
        && data.startingPrice is number
        && data.startingPrice > 0
        && data.startingPrice <= 100000000
    
        && validShopHttpsUrl(data.imageUrl)
    
        && data.isActive is bool
        && data.updatedAt is timestamp;
    }
    
    /* ============================================================
       SHOPS
    ============================================================ */
    
    match /shops/{shopId} {
    
      /* ==========================================================
         READ
      ========================================================== */
    
      allow get:
        if resource.data.isActive == true
        || (
          signedIn()
          && request.auth.uid == shopId
        );
    
      allow list:
        if resource.data.isActive == true;
    
      /* ==========================================================
         CREATE
      ========================================================== */
    
      allow create:
        if signedIn()
    
        && request.auth.uid == shopId
    
        && request.resource.data.keys().hasAll([
          "ownerId",
          "name",
          "category",
          "description",
          "phone",
          "address",
          "latitude",
          "longitude",
          "coverPhotoUrl",
          "logoUrl",
          "businessHours",
          "isActive",
          "rating",
          "reviewCount",
          "serviceCount",
          "minimumStartingPrice",
          "createdAt",
          "updatedAt"
        ])
    
        && request.resource.data.keys().hasOnly([
          "ownerId",
          "name",
          "category",
          "description",
          "phone",
          "address",
          "latitude",
          "longitude",
          "coverPhotoUrl",
          "logoUrl",
          "businessHours",
          "isActive",
          "rating",
          "reviewCount",
          "serviceCount",
          "minimumStartingPrice",
          "createdAt",
          "updatedAt"
        ])
    
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == shopId
    
        && request.resource.data.isActive == true
        && request.resource.data.rating == 0
        && request.resource.data.reviewCount == 0
    
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
    
        && validShopDocument(
          request.resource.data
        );
    
      /* ==========================================================
         UPDATE
      ========================================================== */
    
      allow update:
        if signedIn()
    
        && request.auth.uid == shopId
        && resource.data.ownerId == request.auth.uid
    
        && request.resource.data.ownerId
          == resource.data.ownerId
    
        && request.resource.data.ownerId
          == shopId
    
        && request.resource.data.createdAt
          == resource.data.createdAt
    
        && request.resource.data.rating
          == resource.data.rating
    
        && request.resource.data.reviewCount
          == resource.data.reviewCount
    
        && request.resource.data.updatedAt
          == request.time
    
        && request.resource.data.keys().hasAll([
          "ownerId",
          "name",
          "category",
          "description",
          "phone",
          "address",
          "latitude",
          "longitude",
          "coverPhotoUrl",
          "logoUrl",
          "businessHours",
          "isActive",
          "rating",
          "reviewCount",
          "serviceCount",
          "minimumStartingPrice",
          "createdAt",
          "updatedAt"
        ])
    
        && request.resource.data.keys().hasOnly([
          "ownerId",
          "name",
          "category",
          "description",
          "phone",
          "address",
          "latitude",
          "longitude",
          "coverPhotoUrl",
          "logoUrl",
          "businessHours",
          "isActive",
          "rating",
          "reviewCount",
          "serviceCount",
          "minimumStartingPrice",
          "createdAt",
          "updatedAt"
        ])
    
        && validShopDocument(
          request.resource.data
        );
    
      /* ==========================================================
         DELETE
      ========================================================== */
    
      allow delete: if false;
    
      /* ==========================================================
         SERVICES
      ========================================================== */
    
      match /services/{serviceId} {
    
        /* ========================================================
           READ
        ======================================================== */
    
        allow get:
          if (
            exists(
              /databases/$(database)/documents/shops/$(shopId)
            )
            && get(
              /databases/$(database)/documents/shops/$(shopId)
            ).data.isActive == true
            && resource.data.isActive == true
          )
          || (
            signedIn()
            && request.auth.uid == shopId
          );
    
        allow list:
          if (
            exists(
              /databases/$(database)/documents/shops/$(shopId)
            )
            && get(
              /databases/$(database)/documents/shops/$(shopId)
            ).data.isActive == true
            && resource.data.isActive == true
          )
          || (
            signedIn()
            && request.auth.uid == shopId
          );
    
        /* ========================================================
           CREATE
        ======================================================== */
    
        allow create:
          if signedIn()
    
          && request.auth.uid == shopId
    
          && existsAfter(
            /databases/$(database)/documents/shops/$(shopId)
          )
    
          && getAfter(
            /databases/$(database)/documents/shops/$(shopId)
          ).data.ownerId == request.auth.uid
    
          && request.resource.data.keys().hasAll([
            "id",
            "name",
            "description",
            "startingPrice",
            "imageUrl",
            "isActive",
            "updatedAt"
          ])
    
          && request.resource.data.keys().hasOnly([
            "id",
            "name",
            "description",
            "startingPrice",
            "imageUrl",
            "isActive",
            "updatedAt"
          ])
    
          && request.resource.data.id == serviceId
          && request.resource.data.updatedAt == request.time
    
          && validShopService(
            request.resource.data,
            serviceId
          );
    
        /* ========================================================
           UPDATE
        ======================================================== */
    
        allow update:
          if signedIn()
    
          && request.auth.uid == shopId
    
          && existsAfter(
            /databases/$(database)/documents/shops/$(shopId)
          )
    
          && getAfter(
            /databases/$(database)/documents/shops/$(shopId)
          ).data.ownerId == request.auth.uid
    
          && resource.data.id == serviceId
          && request.resource.data.id == resource.data.id
          && request.resource.data.id == serviceId
    
          && request.resource.data.keys().hasAll([
            "id",
            "name",
            "description",
            "startingPrice",
            "imageUrl",
            "isActive",
            "updatedAt"
          ])
    
          && request.resource.data.keys().hasOnly([
            "id",
            "name",
            "description",
            "startingPrice",
            "imageUrl",
            "isActive",
            "updatedAt"
          ])
    
          && request.resource.data.updatedAt == request.time
    
          && validShopService(
            request.resource.data,
            serviceId
          );
    
        /* ========================================================
           DELETE
        ======================================================== */
    
        allow delete:
          if signedIn()
    
          && request.auth.uid == shopId
          && resource.data.id == serviceId
    
          && exists(
            /databases/$(database)/documents/shops/$(shopId)
          )
    
          && get(
            /databases/$(database)/documents/shops/$(shopId)
          ).data.ownerId == request.auth.uid;
      }
    }
    
    /* ============================================================
       SHOP REQUEST HELPERS
    ============================================================ */
    
    function currentShopForRequest(shopId) {
      return get(
        /databases/$(database)/documents/shops/$(shopId)
      ).data;
    }
    
    function currentServiceForRequest(shopId, serviceId) {
      return get(
        /databases/$(database)/documents/shops/$(shopId)/services/$(serviceId)
      ).data;
    }
    
    /* ============================================================
       REQUEST PHOTOS
    ============================================================ */
    
    function validRequestPhotoUrl(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 2048
        && value.matches("^https://.*");
    }
    
    function validRequestPhotoUrls(photos) {
      return photos is list
        && photos.size() <= 4
    
        && (
          photos.size() < 1
          || validRequestPhotoUrl(photos[0])
        )
    
        && (
          photos.size() < 2
          || validRequestPhotoUrl(photos[1])
        )
    
        && (
          photos.size() < 3
          || validRequestPhotoUrl(photos[2])
        )
    
        && (
          photos.size() < 4
          || validRequestPhotoUrl(photos[3])
        );
    }
    
    /* ============================================================
       REQUEST MEDIA
    ============================================================ */
    
    function validShopRequestMediaUrl(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 2048
        && value.matches("^https://.*");
    }
    
    function validOptionalShopRequestMediaUrl(value) {
      return value == null
        || validShopRequestMediaUrl(value);
    }
    
    /* ============================================================
       REQUEST STATUS
    ============================================================ */
    
    function validShopRequestStatus(status) {
      return status is string
        && status in [
          "pending",
          "accepted",
          "declined",
          "completed",
          "cancelled"
        ];
    }
    
    function validShopRequestTransition(
      oldStatus,
      newStatus
    ) {
      return (
        oldStatus == "pending"
        && (
          newStatus == "accepted"
          || newStatus == "declined"
        )
      )
      || (
        oldStatus == "accepted"
        && newStatus == "completed"
      );
    }
    
    function validCustomerShopRequestCancellation(
      oldStatus,
      newStatus
    ) {
      return oldStatus == "pending"
        && newStatus == "cancelled";
    }
    
    /* ============================================================
       SHOP REQUEST HISTORY HELPERS
    ============================================================ */
    
    function shopRequestPartiesUnchanged() {
      return request.resource.data.id
          == resource.data.id
    
        && request.resource.data.shopId
          == resource.data.shopId
    
        && request.resource.data.workerId
          == resource.data.workerId
    
        && request.resource.data.customerId
          == resource.data.customerId
    
        && request.resource.data.serviceId
          == resource.data.serviceId
    
        && request.resource.data.createdAt
          == resource.data.createdAt;
    }
    
    function terminalShopRequestStatus() {
      return resource.data.status in [
        "completed",
        "cancelled",
        "declined"
      ];
    }
    
    /* ============================================================
       CUSTOMER SOFT DELETE
    ============================================================ */
    
    function canCustomerHideShopRequest() {
      return signedIn()
    
        && resource.data.customerId
          == request.auth.uid
    
        && terminalShopRequestStatus()
    
        && shopRequestPartiesUnchanged()
    
        && request.resource.data.status
          == resource.data.status
    
        && resource.data.get(
          "deletedByCustomer",
          false
        ) != true
    
        && request.resource.data.deletedByCustomer
          == true
    
        && request.resource.data.deletedByCustomerAt
          == request.time
    
        && request.resource.data.updatedAt
          == request.time
    
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "deletedByCustomer",
            "deletedByCustomerAt",
            "updatedAt"
          ]);
    }
    
    /* ============================================================
       WORKER SOFT DELETE
    ============================================================ */
    
    function canWorkerHideShopRequest() {
      return signedIn()
    
        && resource.data.workerId
          == request.auth.uid
    
        && terminalShopRequestStatus()
    
        && shopRequestPartiesUnchanged()
    
        && request.resource.data.status
          == resource.data.status
    
        && resource.data.get(
          "deletedByWorker",
          false
        ) != true
    
        && request.resource.data.deletedByWorker
          == true
    
        && request.resource.data.deletedByWorkerAt
          == request.time
    
        && request.resource.data.updatedAt
          == request.time
    
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "deletedByWorker",
            "deletedByWorkerAt",
            "updatedAt"
          ]);
    }
    
    /* ============================================================
       SHOP REQUEST DOCUMENT
    ============================================================ */
    
    function validShopRequestDocument(data) {
      return data.id is string
        && data.id.size() > 0
        && data.id.size() <= 128
    
        && data.shopId is string
        && data.shopId.size() > 0
        && data.shopId.size() <= 128
    
        && data.shopName is string
        && data.shopName.size() > 0
        && data.shopName.size() <= 100
    
        /* Shop media */
        && validShopRequestMediaUrl(
          data.shopPhotoUrl
        )
    
        && validShopRequestMediaUrl(
          data.shopLogoUrl
        )
    
        && data.workerId is string
        && data.workerId.size() > 0
        && data.workerId.size() <= 128
    
        && data.customerId is string
        && data.customerId.size() > 0
        && data.customerId.size() <= 128
    
        && data.customerName is string
        && data.customerName.size() > 0
        && data.customerName.size() <= 120
    
        /* Customer media can legitimately be null */
        && validOptionalShopRequestMediaUrl(
          data.customerPhotoUrl
        )
    
        && data.serviceId is string
        && data.serviceId.size() > 0
        && data.serviceId.size() <= 128
    
        && data.serviceName is string
        && data.serviceName.size() > 0
        && data.serviceName.size() <= 100
    
        && data.servicePrice is number
        && data.servicePrice > 0
        && data.servicePrice <= 100000000
    
        /* Service media */
        && validShopRequestMediaUrl(
          data.serviceImageUrl
        )
    
        && data.requestedDateKey is string
        && data.requestedDateKey.size() > 0
        && data.requestedDateKey.size() <= 30
    
        && data.requestedDateLabel is string
        && data.requestedDateLabel.size() > 0
        && data.requestedDateLabel.size() <= 100
    
        && data.requestedTime is string
        && data.requestedTime.size() > 0
        && data.requestedTime.size() <= 50
    
        && data.description is string
        && data.description.size() <= 500
    
        && validRequestPhotoUrls(
          data.photoUrls
        )
    
        && validShopRequestStatus(
          data.status
        )
    
        && data.deletedByCustomer is bool
    
        && (
          data.deletedByCustomerAt == null
          || data.deletedByCustomerAt is timestamp
        )
    
        && data.deletedByWorker is bool
    
        && (
          data.deletedByWorkerAt == null
          || data.deletedByWorkerAt is timestamp
        )
    
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }
    
    /* ============================================================
       SHOP REQUESTS
    ============================================================ */
    
    match /shopRequests/{requestId} {
    
      /* ==========================================================
         READ ONE
      ========================================================== */
    
      allow get:
        if signedIn()
        && (
          resource.data.customerId == request.auth.uid
          || resource.data.workerId == request.auth.uid
        );
    
      /* ==========================================================
         LIST
      ========================================================== */
    
      allow list:
        if signedIn()
        && (
          resource.data.customerId == request.auth.uid
          || resource.data.workerId == request.auth.uid
        );
    
      /* ==========================================================
         CREATE
      ========================================================== */
    
      allow create:
        if signedIn()
    
        && request.resource.data.keys().hasAll([
          "id",
          "shopId",
          "shopName",
          "shopPhotoUrl",
          "shopLogoUrl",
          "workerId",
          "customerId",
          "customerName",
          "customerPhotoUrl",
          "serviceId",
          "serviceName",
          "servicePrice",
          "serviceImageUrl",
          "requestedDateKey",
          "requestedDateLabel",
          "requestedTime",
          "description",
          "photoUrls",
          "status",
          "deletedByCustomer",
          "deletedByCustomerAt",
          "deletedByWorker",
          "deletedByWorkerAt",
          "createdAt",
          "updatedAt"
        ])
    
        && request.resource.data.keys().hasOnly([
          "id",
          "shopId",
          "shopName",
          "shopPhotoUrl",
          "shopLogoUrl",
          "workerId",
          "customerId",
          "customerName",
          "customerPhotoUrl",
          "serviceId",
          "serviceName",
          "servicePrice",
          "serviceImageUrl",
          "requestedDateKey",
          "requestedDateLabel",
          "requestedTime",
          "description",
          "photoUrls",
          "status",
          "deletedByCustomer",
          "deletedByCustomerAt",
          "deletedByWorker",
          "deletedByWorkerAt",
          "createdAt",
          "updatedAt"
        ])
    
        /* Document identity */
        && request.resource.data.id == requestId
    
        /* Customer ownership */
        && request.resource.data.customerId
          == request.auth.uid
    
        /* Initial state */
        && request.resource.data.status
          == "pending"
    
        && request.resource.data.deletedByCustomer
          == false
    
        && request.resource.data.deletedByCustomerAt
          == null
    
        && request.resource.data.deletedByWorker
          == false
    
        && request.resource.data.deletedByWorkerAt
          == null
    
        /* Shop must exist and be active */
        && currentShopForRequest(
          request.resource.data.shopId
        ).isActive == true
    
        /* Worker must be the real shop owner */
        && request.resource.data.workerId
          == currentShopForRequest(
            request.resource.data.shopId
          ).ownerId
    
        /* Customer cannot request own shop */
        && request.resource.data.workerId
          != request.auth.uid
    
        /* Shop name must come from Firestore */
        && request.resource.data.shopName
          == currentShopForRequest(
            request.resource.data.shopId
          ).name
    
        /* Shop media must match authoritative shop data */
        && request.resource.data.shopPhotoUrl
          == currentShopForRequest(
            request.resource.data.shopId
          ).coverPhotoUrl
    
        && request.resource.data.shopLogoUrl
          == currentShopForRequest(
            request.resource.data.shopId
          ).logoUrl
    
        /* Service must belong to that shop and be active */
        && currentServiceForRequest(
          request.resource.data.shopId,
          request.resource.data.serviceId
        ).isActive == true
    
        /* Service name must come from Firestore */
        && request.resource.data.serviceName
          == currentServiceForRequest(
            request.resource.data.shopId,
            request.resource.data.serviceId
          ).name
    
        /* Service price must come from Firestore */
        && request.resource.data.servicePrice
          == currentServiceForRequest(
            request.resource.data.shopId,
            request.resource.data.serviceId
          ).startingPrice
    
        /* Service image must match authoritative service data */
        && request.resource.data.serviceImageUrl
          == currentServiceForRequest(
            request.resource.data.shopId,
            request.resource.data.serviceId
          ).imageUrl
    
        /* Server timestamps */
        && request.resource.data.createdAt
          == request.time
    
        && request.resource.data.updatedAt
          == request.time
    
        /* Complete schema validation */
        && validShopRequestDocument(
          request.resource.data
        );
    
      /* ==========================================================
         STATUS UPDATE
      ========================================================== */
    
      allow update:
        if signedIn()
    
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "status",
            "updatedAt"
          ])
    
        && request.resource.data.updatedAt
          == request.time
    
        && validShopRequestStatus(
          request.resource.data.status
        )
    
        && shopRequestPartiesUnchanged()
    
        && (
          (
            resource.data.workerId
              == request.auth.uid
    
            && resource.data.get(
              "deletedByWorker",
              false
            ) != true
    
            && validShopRequestTransition(
              resource.data.status,
              request.resource.data.status
            )
          )
    
          ||
    
          (
            resource.data.customerId
              == request.auth.uid
    
            && resource.data.get(
              "deletedByCustomer",
              false
            ) != true
    
            && validCustomerShopRequestCancellation(
              resource.data.status,
              request.resource.data.status
            )
          )
        );
    
      /* ==========================================================
         CUSTOMER SOFT DELETE
      ========================================================== */
    
      allow update:
        if canCustomerHideShopRequest();
    
      /* ==========================================================
         WORKER SOFT DELETE
      ========================================================== */
    
      allow update:
        if canWorkerHideShopRequest();
    
      /* ==========================================================
         HARD DELETE DISABLED
      ========================================================== */
    
      allow delete: if false;
    }

    /* ============================================================
       SOURCE: firestore/rules/07-misc.rules
    ============================================================ */

    /* ============================================================
       FIXXAM — MISCELLANEOUS FIRESTORE RULES
    
       IMPORTANT:
       This is a PARTIAL Firestore rules source file.
    
       Do NOT add:
       - rules_version
       - service cloud.firestore
       - match /databases/{database}/documents
       - closing braces for the root wrapper
    
       The build script manages the Firestore wrapper.
    ============================================================ */
    
    
    /* ============================================================
       WORKER CONTACTS
    
       Structure:
    
       workerContacts/{workerId}/customers/{customerId}
    
       Contacts are created by the trusted backend after a valid
       customer -> worker call relationship is established.
    
       The worker can read only their own contacts.
    
       Clients are not allowed to create, update, or delete
       contact records directly.
    ============================================================ */
    
    match /workerContacts/{workerId}/customers/{customerId} {
    
      allow read:
        if signedIn()
        && request.auth.uid == workerId;
    
      allow create, update, delete:
        if false;
    }
    
    
    /* ============================================================
       DEFAULT FALLBACK
    
       Unknown Firestore paths are denied by default.
    ============================================================ */
    
    match /{document=**} {
      allow read, write: if false;
    }

    /* ============================================================
       SOURCE: firestore/rules/09-reviews.rules
    ============================================================ */

    /* ============================================================
    REVIEWS
    
    Supports:
    
    1. Worker reviews
    targetType = "worker"
    Rating 1-5 + comment
    
    
    2. Product reviews
    targetType = "product"
    Rating 1-5 + comment
    
    Product review also stores workerId
    so the product owner can receive the
    separate fixed 3-star worker rating.
    
    
    3. Shop reviews
    targetType = "shop"
    Rating 1-5
    Comment optional
    
    
    
    Worker review fields:
    
    customerId
    customerName
    workerId
    workerName
    targetId
    targetType
    rating
    comment
    createdAt
    updatedAt
    
    
    Product review fields:
    
    customerId
    customerName
    productId
    productName
    workerId
    targetId
    targetType
    rating
    comment
    createdAt
    updatedAt
    
    
    Shop review fields:
    
    customerId
    customerName
    shopId
    targetId
    targetType
    rating
    comment
    createdAt
    updatedAt
    ============================================================ */
    
    
    match /reviews/{reviewId} {
    
    /* ==========================================================
    COMMON HELPERS
    ========================================================== */
    
    function validReviewComment() {
      return request.resource.data.comment is string
        && request.resource.data.comment.size() >= 3
        && request.resource.data.comment.size() <= 500;
    }
    
    function validReviewCustomerName() {
      return request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 150;
    }
    
    function validReviewRating() {
      return request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
    }
    
    
    /* ==========================================================
    WORKER REVIEW HELPERS
    ========================================================== */
    
    function validWorkerReviewWorkerName() {
      return request.resource.data.workerName is string
        && request.resource.data.workerName.size() > 0
        && request.resource.data.workerName.size() <= 150;
    }
    
    function validWorkerReviewFields() {
      return request.resource.data.keys().hasOnly([
        "customerId",
        "customerName",
        "workerId",
        "workerName",
        "targetId",
        "targetType",
        "rating",
        "comment",
        "createdAt",
        "updatedAt"
      ]);
    }
    
    function hasRequiredWorkerReviewFields() {
      return request.resource.data.keys().hasAll([
        "customerId",
        "customerName",
        "workerId",
        "workerName",
        "targetId",
        "targetType",
        "rating",
        "comment",
        "createdAt",
        "updatedAt"
      ]);
    }
    
    function validWorkerReviewData() {
      return signedIn()
    
        && request.resource.data.customerId
          == request.auth.uid
    
        && request.resource.data.customerId is string
    
        && request.resource.data.customerId.size() > 0
    
        && request.resource.data.workerId is string
    
        && request.resource.data.workerId.size() > 0
    
        && request.resource.data.workerId
          != request.auth.uid
    
        && request.resource.data.targetType
          == "worker"
    
        && request.resource.data.targetId
          == request.resource.data.workerId
    
        && validReviewRating()
    
        && validReviewComment()
    
        && validReviewCustomerName()
    
        && validWorkerReviewWorkerName()
    
        && hasRequiredWorkerReviewFields()
    
        && validWorkerReviewFields();
    }
    
    
    /* ==========================================================
    PRODUCT REVIEW HELPERS
    ========================================================== */
    
    function validProductReviewProductName() {
      return request.resource.data.productName is string
        && request.resource.data.productName.size() > 0
        && request.resource.data.productName.size() <= 200;
    }
    
    function validProductReviewWorkerId() {
      return request.resource.data.workerId is string
        && request.resource.data.workerId.size() > 0
        && request.resource.data.workerId
          != request.auth.uid;
    }
    
    function validProductReviewFields() {
      return request.resource.data.keys().hasOnly([
        "customerId",
        "customerName",
        "productId",
        "productName",
        "workerId",
        "targetId",
        "targetType",
        "rating",
        "comment",
        "createdAt",
        "updatedAt"
      ]);
    }
    
    function hasRequiredProductReviewFields() {
      return request.resource.data.keys().hasAll([
        "customerId",
        "customerName",
        "productId",
        "productName",
        "workerId",
        "targetId",
        "targetType",
        "rating",
        "comment",
        "createdAt",
        "updatedAt"
      ]);
    }
    
    function validProductReviewData() {
      return signedIn()
    
        && request.resource.data.customerId
          == request.auth.uid
    
        && request.resource.data.customerId is string
    
        && request.resource.data.customerId.size() > 0
    
        && request.resource.data.productId is string
    
        && request.resource.data.productId.size() > 0
    
        && exists(
          /databases/$(database)/documents/products/$(request.resource.data.productId)
        )
    
        && validProductReviewWorkerId()
    
        && request.resource.data.targetType
          == "product"
    
        && request.resource.data.targetId
          == request.resource.data.productId
    
        && validReviewRating()
    
        && validReviewComment()
    
        && validReviewCustomerName()
    
        && validProductReviewProductName()
    
        && hasRequiredProductReviewFields()
    
        && validProductReviewFields();
    }
    
    
    /* ==========================================================
    SHOP REVIEW HELPERS
    ========================================================== */
    
    function validShopReviewComment() {
      return request.resource.data.comment is string
    
        && request.resource.data.comment.size() <= 500
    
        && (
          request.resource.data.comment.size() == 0
          ||
          request.resource.data.comment.size() >= 3
        );
    }
    
    function validShopReviewFields() {
      return request.resource.data.keys().hasOnly([
        "customerId",
        "customerName",
        "shopId",
        "targetId",
        "targetType",
        "rating",
        "comment",
        "createdAt",
        "updatedAt"
      ]);
    }
    
    function hasRequiredShopReviewFields() {
      return request.resource.data.keys().hasAll([
        "customerId",
        "customerName",
        "shopId",
        "targetId",
        "targetType",
        "rating",
        "comment",
        "createdAt",
        "updatedAt"
      ]);
    }
    
    
    /* ==========================================================
    SHOP REVIEW CUSTOMER NAME SECURITY
    
    The review name must match the authenticated
    customer's saved profile.
    
    Supported profile formats:
    
    1. fullName
    
    OR
    
    2. firstName + surname
    
    OR
    
    3. firstName + otherName + surname
    
    This matches the customer name construction
    used by shopReviewService.ts.
    ========================================================== */
    
    function validShopReviewCustomerName() {
      return signedIn()
    
        && request.resource.data.customerId is string
    
        && request.resource.data.customerId
          == request.auth.uid
    
        && request.resource.data.customerName is string
    
        && request.resource.data.customerName.size() > 0
    
        && request.resource.data.customerName.size() <= 150
    
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
    
        && (
          /* ----------------------------------------------
             OPTION 1: fullName
          ---------------------------------------------- */
    
          (
            get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.fullName is string
    
            && get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.fullName.size() > 0
    
            && get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.fullName.size() <= 150
    
            && request.resource.data.customerName
              ==
              get(
                /databases/$(database)/documents/users/$(request.auth.uid)
              ).data.fullName
          )
    
          ||
    
          /* ----------------------------------------------
             OPTION 2: firstName + otherName + surname
          ---------------------------------------------- */
    
          (
            get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.firstName is string
    
            && get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.firstName.size() > 0
    
            && get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.otherName is string
    
            && get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.otherName.size() > 0
    
            && get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.surname is string
    
            && get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.surname.size() > 0
    
            && request.resource.data.customerName
              ==
              (
                get(
                  /databases/$(database)/documents/users/$(request.auth.uid)
                ).data.firstName
    
                + " "
    
                + get(
                  /databases/$(database)/documents/users/$(request.auth.uid)
                ).data.otherName
    
                + " "
    
                + get(
                  /databases/$(database)/documents/users/$(request.auth.uid)
                ).data.surname
              )
          )
    
          ||
    
          /* ----------------------------------------------
             OPTION 3: firstName + surname
          ---------------------------------------------- */
    
          (
            get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.firstName is string
    
            && get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.firstName.size() > 0
    
            && get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.surname is string
    
            && get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.surname.size() > 0
    
            && (
              !(
                get(
                  /databases/$(database)/documents/users/$(request.auth.uid)
                ).data.otherName is string
              )
    
              ||
    
              get(
                /databases/$(database)/documents/users/$(request.auth.uid)
              ).data.otherName.size() == 0
            )
    
            && request.resource.data.customerName
              ==
              (
                get(
                  /databases/$(database)/documents/users/$(request.auth.uid)
                ).data.firstName
    
                + " "
    
                + get(
                  /databases/$(database)/documents/users/$(request.auth.uid)
                ).data.surname
              )
          )
        );
    }
    
    
    function validShopReviewData() {
      return signedIn()
    
        /* Customer must be themselves */
    
        && request.resource.data.customerId
          == request.auth.uid
    
        && request.resource.data.customerId is string
    
        && request.resource.data.customerId.size() > 0
    
        /* Shop ID */
    
        && request.resource.data.shopId is string
    
        && request.resource.data.shopId.size() > 0
    
        /* Shop must exist */
    
        && exists(
          /databases/$(database)/documents/shops/$(request.resource.data.shopId)
        )
    
        /* Shop must be active */
    
        && get(
          /databases/$(database)/documents/shops/$(request.resource.data.shopId)
        ).data.isActive == true
    
        /* Owner cannot review own shop */
    
        && get(
          /databases/$(database)/documents/shops/$(request.resource.data.shopId)
        ).data.ownerId
          != request.auth.uid
    
        /* Target */
    
        && request.resource.data.targetType
          == "shop"
    
        && request.resource.data.targetId
          == request.resource.data.shopId
    
        /* Rating 1-5 */
    
        && validReviewRating()
    
        /* Optional comment */
    
        && validShopReviewComment()
    
        /* Customer name */
    
        && validShopReviewCustomerName()
    
        /* Schema */
    
        && hasRequiredShopReviewFields()
    
        && validShopReviewFields();
    }
    
    
    /* ==========================================================
    CREATE
    ========================================================== */
    
    function validReviewCreate() {
      return (
        validWorkerReviewData()
    
        ||
    
        validProductReviewData()
    
        ||
    
        validShopReviewData()
      )
    
      && request.resource.data.createdAt
        == request.time
    
      && request.resource.data.updatedAt
        == request.time;
    }
    
    
    /* ==========================================================
    WORKER REVIEW UPDATE
    ========================================================== */
    
    function validWorkerReviewUpdate() {
      return signedIn()
    
        && resource.data.targetType
          == "worker"
    
        && resource.data.customerId
          == request.auth.uid
    
        && request.resource.data.customerId
          == request.auth.uid
    
        && request.resource.data.customerId
          == resource.data.customerId
    
        && request.resource.data.workerId
          == resource.data.workerId
    
        && request.resource.data.targetId
          == resource.data.targetId
    
        && request.resource.data.targetType
          == resource.data.targetType
    
        && request.resource.data.createdAt
          == resource.data.createdAt
    
        && request.resource.data.updatedAt
          == request.time
    
        && validWorkerReviewData();
    }
    
    
    /* ==========================================================
    PRODUCT REVIEW UPDATE
    ========================================================== */
    
    function validProductReviewUpdate() {
      return signedIn()
    
        && resource.data.targetType
          == "product"
    
        && resource.data.customerId
          == request.auth.uid
    
        && request.resource.data.customerId
          == request.auth.uid
    
        && request.resource.data.customerId
          == resource.data.customerId
    
        && request.resource.data.productId
          == resource.data.productId
    
        && request.resource.data.workerId
          == resource.data.workerId
    
        && request.resource.data.targetId
          == resource.data.targetId
    
        && request.resource.data.targetType
          == resource.data.targetType
    
        && request.resource.data.createdAt
          == resource.data.createdAt
    
        && request.resource.data.updatedAt
          == request.time
    
        && validProductReviewData();
    }
    
    
    /* ==========================================================
    SHOP REVIEW UPDATE
    ========================================================== */
    
    function validShopReviewUpdate() {
      return signedIn()
    
        && resource.data.targetType
          == "shop"
    
        && resource.data.customerId
          == request.auth.uid
    
        && request.resource.data.customerId
          == request.auth.uid
    
        /* Identity cannot change */
    
        && request.resource.data.customerId
          == resource.data.customerId
    
        && request.resource.data.shopId
          == resource.data.shopId
    
        && request.resource.data.targetId
          == resource.data.targetId
    
        && request.resource.data.targetType
          == resource.data.targetType
    
        /* Created timestamp cannot change */
    
        && request.resource.data.createdAt
          == resource.data.createdAt
    
        /* Updated timestamp */
    
        && request.resource.data.updatedAt
          == request.time
    
        /* Final document */
    
        && validShopReviewData();
    }
    
    
    function validReviewUpdate() {
      return validWorkerReviewUpdate()
    
        ||
    
        validProductReviewUpdate()
    
        ||
    
        validShopReviewUpdate();
    }
    
    
    /* ==========================================================
    READ
    ========================================================== */
    
    allow read:
      if signedIn();
    
    
    /* ==========================================================
    CREATE
    ========================================================== */
    
    allow create:
      if validReviewCreate();
    
    
    /* ==========================================================
    UPDATE
    ========================================================== */
    
    allow update:
      if validReviewUpdate();
    
    
    /* ==========================================================
    DELETE
    
    Reviews cannot be deleted from client.
    
    ========================================================== */
    
    allow delete:
      if false;
    }
    
    
    /* ============================================================
    WORKER RATINGS
    
    Quick Rate:
    Customer gives worker fixed 3 stars.
    
    Also used after Product Review:
    Product review rating may be 1-5,
    but worker receives fixed 3 stars only.
    
    One customer = one quick rating per worker.
    
    Document ID:
    {workerId}_{customerId}
    
    Rate   -> create
    Unrate -> delete
    ============================================================ */
    
    match /workerRatings/{ratingId} {
    
      function validWorkerRatingFields() {
        return request.resource.data.keys().hasOnly([
          "customerId",
          "workerId",
          "rating",
          "createdAt",
          "updatedAt"
        ]);
      }
    
      function hasRequiredWorkerRatingFields() {
        return request.resource.data.keys().hasAll([
          "customerId",
          "workerId",
          "rating",
          "createdAt",
          "updatedAt"
        ]);
      }
    
      function validWorkerRatingId() {
        return ratingId
          ==
          request.resource.data.workerId
          + "_"
          + request.auth.uid;
      }
    
      function validWorkerRatingData() {
        return signedIn()
    
          && request.resource.data.customerId
            == request.auth.uid
    
          && request.resource.data.customerId is string
    
          && request.resource.data.customerId.size() > 0
    
          && request.resource.data.workerId is string
    
          && request.resource.data.workerId.size() > 0
    
          && request.resource.data.workerId
            != request.auth.uid
    
          && request.resource.data.rating is number
    
          && request.resource.data.rating
            == 3
    
          && validWorkerRatingId()
    
          && hasRequiredWorkerRatingFields()
    
          && validWorkerRatingFields();
      }
    
      function validWorkerRatingCreate() {
        return validWorkerRatingData()
    
          && request.resource.data.createdAt
            == request.time
    
          && request.resource.data.updatedAt
            == request.time;
      }
    
      allow read:
        if signedIn();
    
      allow create:
        if validWorkerRatingCreate();
    
      allow update:
        if false;
    
      allow delete:
        if signedIn()
    
          && resource.data.customerId is string
    
          && resource.data.customerId
            == request.auth.uid
    
          && resource.data.workerId is string
    
          && resource.data.workerId.size() > 0
    
          && resource.data.workerId
            != request.auth.uid
    
          && resource.data.rating is number
    
          && resource.data.rating
            == 3
    
          && ratingId
            == resource.data.workerId
            + "_"
            + request.auth.uid;
    }
    
    
    /* ============================================================
    PRODUCT RATINGS
    
    Rating action from Product Card menu.
    
    Separate from:
    
    workerRating displayed on product card
    
    1-5 star Product Review rating
    
    One customer = one product rating.
    
    Document ID:
    {productId}_{customerId}
    
    Rating -> create
    Unrate -> delete
    ============================================================ */
    
    match /productRatings/{ratingId} {
    
      function validProductRatingFields() {
        return request.resource.data.keys().hasOnly([
          "customerId",
          "productId",
          "createdAt"
        ]);
      }
    
      function hasRequiredProductRatingFields() {
        return request.resource.data.keys().hasAll([
          "customerId",
          "productId",
          "createdAt"
        ]);
      }
    
      function validProductRatingId() {
        return ratingId
          ==
          request.resource.data.productId
          + "_"
          + request.auth.uid;
      }
    
      function validProductRatingCreate() {
        return signedIn()
    
          && request.resource.data.customerId
            == request.auth.uid
    
          && request.resource.data.customerId is string
    
          && request.resource.data.customerId.size() > 0
    
          && request.resource.data.productId is string
    
          && request.resource.data.productId.size() > 0
    
          && exists(
            /databases/$(database)/documents/products/$(request.resource.data.productId)
          )
    
          && validProductRatingId()
    
          && hasRequiredProductRatingFields()
    
          && validProductRatingFields()
    
          && request.resource.data.createdAt
            == request.time;
      }
    
      allow read:
        if signedIn();
    
      allow create:
        if validProductRatingCreate();
    
      allow update:
        if false;
    
      allow delete:
        if signedIn()
    
          && resource.data.customerId is string
    
          && resource.data.customerId
            == request.auth.uid
    
          && resource.data.productId is string
    
          && resource.data.productId.size() > 0
    
          && ratingId
            == resource.data.productId
            + "_"
            + request.auth.uid;
    }
    
    
    /* ============================================================
    PUBLIC WORKER REVIEWS
    
    Public-safe mirror for Worker Reviews.
    
    IMPORTANT:
    This collection intentionally does NOT contain:
    
    customerId
    
    private customer profile data
    
    Public fields:
    
    customerName
    workerId
    workerName
    rating
    comment
    createdAt
    
    READ:
    Public
    
    CREATE:
    Only allowed when the matching private
    /reviews/{reviewId} document is created
    in the same atomic transaction.
    
    UPDATE:
    Not allowed from client.
    
    DELETE:
    Not allowed from client.
    ============================================================ */
    
    match /publicWorkerReviews/{reviewId} {
    
    
    /* ==========================================================
    FIELD VALIDATION
    ========================================================== */
    
    function validPublicWorkerReviewFields() {
      return request.resource.data.keys().hasOnly([
        "customerName",
        "workerId",
        "workerName",
        "rating",
        "comment",
        "createdAt"
      ]);
    }
    
    
    function hasRequiredPublicWorkerReviewFields() {
      return request.resource.data.keys().hasAll([
        "customerName",
        "workerId",
        "workerName",
        "rating",
        "comment",
        "createdAt"
      ]);
    }
    
    
    function validPublicWorkerReviewData() {
      return request.resource.data.customerName is string
    
        && request.resource.data.customerName.size() > 0
    
        && request.resource.data.customerName.size() <= 150
    
        && request.resource.data.workerId is string
    
        && request.resource.data.workerId.size() > 0
    
        && request.resource.data.workerName is string
    
        && request.resource.data.workerName.size() > 0
    
        && request.resource.data.workerName.size() <= 150
    
        && request.resource.data.rating is number
    
        && request.resource.data.rating >= 1
    
        && request.resource.data.rating <= 5
    
        && request.resource.data.comment is string
    
        && request.resource.data.comment.size() >= 3
    
        && request.resource.data.comment.size() <= 500;
    }
    
    
    /* ==========================================================
    READ
    
    Worker reviews are public content.
    
    ========================================================== */
    
    allow read:
      if true;
    
    
    /* ==========================================================
    CREATE
    
    The public document can only be created together with
    the matching private review document.
    
    This prevents a client from creating arbitrary
    fake public reviews directly.
    
    ========================================================== */
    
    allow create:
      if signedIn()
    
        && validPublicWorkerReviewData()
    
        && validPublicWorkerReviewFields()
    
        && hasRequiredPublicWorkerReviewFields()
    
        && getAfter(
          /databases/$(database)/documents/reviews/$(reviewId)
        ).data.targetType
          == "worker"
    
        && getAfter(
          /databases/$(database)/documents/reviews/$(reviewId)
        ).data.workerId
          == request.resource.data.workerId
    
        && getAfter(
          /databases/$(database)/documents/reviews/$(reviewId)
        ).data.workerName
          == request.resource.data.workerName
    
        && getAfter(
          /databases/$(database)/documents/reviews/$(reviewId)
        ).data.customerName
          == request.resource.data.customerName
    
        && getAfter(
          /databases/$(database)/documents/reviews/$(reviewId)
        ).data.rating
          == request.resource.data.rating
    
        && getAfter(
          /databases/$(database)/documents/reviews/$(reviewId)
        ).data.comment
          == request.resource.data.comment
    
        && getAfter(
          /databases/$(database)/documents/reviews/$(reviewId)
        ).data.createdAt
          == request.resource.data.createdAt;
    
    
    /* ==========================================================
    UPDATE
    
    Public mirrors cannot be edited directly.
    
    ========================================================== */
    
    allow update:
      if false;
    
    
    /* ==========================================================
    DELETE
    
    Public mirrors cannot be deleted from client.
    
    ========================================================== */
    
    allow delete:
      if false;
    }

    /* ============================================================
       SOURCE: firestore/rules/10-saved-workers.rules
    ============================================================ */

    /* ============================================================
       SAVED WORKERS
    
       Collection:
       /savedWorkers/{savedWorkerId}
    
       Document ID:
       {workerId}_{customerId}
    
       CUSTOMER:
       - save worker
       - read own saved state
       - list own saved workers
       - unsave worker
    
       WORKER:
       - list customers who saved them
    
       SECURITY:
       - customer cannot save themselves
       - deterministic document ID prevents duplicates
       - saved relationship cannot be updated
       - only the customer who created it can delete it
    ============================================================ */
    
    
    /* ============================================================
       SAVED WORKERS
    ============================================================ */
    
    match /savedWorkers/{savedWorkerId} {
    
    
      /* ==========================================================
         CREATE — CUSTOMER SAVES WORKER
      ========================================================== */
    
      allow create:
        if signedIn()
    
        && request.resource.data.customerId
          == request.auth.uid
    
        && request.resource.data.workerId
          is string
    
        && request.resource.data.workerId.size()
          > 0
    
        && request.resource.data.workerId.size()
          <= 128
    
        /* Customer cannot save themselves */
        && request.resource.data.workerId
          != request.auth.uid
    
        /* Deterministic document ID */
        && savedWorkerId
          == request.resource.data.workerId
            + "_"
            + request.auth.uid
    
        /* Customer name */
        && request.resource.data.customerName
          is string
    
        && request.resource.data.customerName.size()
          > 0
    
        && request.resource.data.customerName.size()
          <= 200
    
        /* Customer photo */
        && request.resource.data.customerPhotoUrl
          is string
    
        && request.resource.data.customerPhotoUrl.size()
          <= 2048
    
        /* Server timestamps */
        && request.resource.data.createdAt
          == request.time
    
        && request.resource.data.updatedAt
          == request.time
    
        /* Exact document schema */
        && request.resource.data.keys().hasOnly([
          "workerId",
          "customerId",
          "customerName",
          "customerPhotoUrl",
          "createdAt",
          "updatedAt"
        ]);
    
    
      /* ==========================================================
         GET — CUSTOMER READS ONE SAVED STATE
    
         Example document:
    
         worker123_customer456
                         ^^^^^^^^^
                         current customer UID
      ========================================================== */
    
      allow get:
        if signedIn()
    
        && savedWorkerId.matches(
          "^.+_"
          + request.auth.uid
          + "$"
        );
    
    
      /* ==========================================================
         LIST — CUSTOMER OR WORKER
    
         CUSTOMER QUERY:
    
         where(
           "customerId",
           "==",
           auth.currentUser.uid
         )
    
         WORKER QUERY:
    
         where(
           "workerId",
           "==",
           auth.currentUser.uid
         )
      ========================================================== */
    
      allow list:
        if signedIn()
    
        && (
          resource.data.customerId
            == request.auth.uid
    
          ||
    
          resource.data.workerId
            == request.auth.uid
        );
    
    
      /* ==========================================================
         UPDATE
    
         Saved relationship is immutable.
      ========================================================== */
    
      allow update:
        if false;
    
    
      /* ==========================================================
         DELETE — CUSTOMER UNSAVES WORKER
      ========================================================== */
    
      allow delete:
        if signedIn()
    
        && resource.data.customerId
          == request.auth.uid
    
        && resource.data.workerId
          is string
    
        && resource.data.workerId.size()
          > 0
    
        /* Deterministic document ID */
        && savedWorkerId
          == resource.data.workerId
            + "_"
            + request.auth.uid;
    }

  }
}
