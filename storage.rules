rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    /* =========================================================
       HELPERS
    ========================================================= */

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn()
        && request.auth.uid == userId;
    }

    /*
     * Maximum image size:
     * 10 MB
     *
     * Allowed:
     * JPEG
     * JPG
     * PNG
     * WEBP
     * HEIC
     * HEIF
     */
    function isValidImageUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches(
          'image/(jpeg|jpg|png|webp|heic|heif)'
        );
    }


    /* =========================================================
       USER PROFILE PHOTOS

       users/{userId}/profile/{fileName}
    ========================================================= */

    match /users/{userId}/profile/{fileName} {

      allow create: if
        isOwner(userId)
        && isValidImageUpload();

      allow update: if
        isOwner(userId)
        && isValidImageUpload();

      allow delete: if
        isOwner(userId);

      allow read: if
        signedIn();
    }


    /* =========================================================
       USER ROOT PHOTOS

       users/{userId}/{fileName}

       Supports customer registration/profile uploads such as:

       users/{uid}/customer-profile.jpeg
       users/{uid}/customer-profile-123.jpeg
    ========================================================= */

    match /users/{userId}/{fileName} {

      /*
       * Only the authenticated owner can upload.
       */
      allow create: if
        isOwner(userId)
        && isValidImageUpload();

      /*
       * Only the authenticated owner can replace.
       */
      allow update: if
        isOwner(userId)
        && isValidImageUpload();

      /*
       * Only the authenticated owner can delete.
       */
      allow delete: if
        isOwner(userId);

      /*
       * Signed-in users can read user images.
       */
      allow read: if
        signedIn();
    }


    /* =========================================================
       WORKER PROFILE PHOTOS

       workers/{workerId}/profile/{fileName}
    ========================================================= */

    match /workers/{workerId}/profile/{fileName} {

      allow create: if
        isOwner(workerId)
        && isValidImageUpload();

      allow update: if
        isOwner(workerId)
        && isValidImageUpload();

      allow delete: if
        isOwner(workerId);

      allow read: if
        signedIn();
    }


    /* =========================================================
       WORKER GALLERY PHOTOS

       workers/{workerId}/gallery/{fileName}
    ========================================================= */

    match /workers/{workerId}/gallery/{fileName} {

      allow create: if
        isOwner(workerId)
        && isValidImageUpload();

      allow update: if
        isOwner(workerId)
        && isValidImageUpload();

      allow delete: if
        isOwner(workerId);

      allow read: if
        signedIn();
    }


    /* =========================================================
       SHOPS — COVER PHOTO

       shops/{ownerId}/cover/{fileName}
    ========================================================= */

    match /shops/{ownerId}/cover/{fileName} {

      allow create: if
        isOwner(ownerId)
        && isValidImageUpload();

      allow update: if
        isOwner(ownerId)
        && isValidImageUpload();

      allow delete: if
        isOwner(ownerId);

      allow read: if
        signedIn();
    }


    /* =========================================================
       SHOPS — LOGO

       shops/{ownerId}/logo/{fileName}
    ========================================================= */

    match /shops/{ownerId}/logo/{fileName} {

      allow create: if
        isOwner(ownerId)
        && isValidImageUpload();

      allow update: if
        isOwner(ownerId)
        && isValidImageUpload();

      allow delete: if
        isOwner(ownerId);

      allow read: if
        signedIn();
    }


    /* =========================================================
       SHOPS — SERVICE IMAGES

       shops/{ownerId}/services/{fileName}
    ========================================================= */

    match /shops/{ownerId}/services/{fileName} {

      allow create: if
        isOwner(ownerId)
        && isValidImageUpload();

      allow update: if
        isOwner(ownerId)
        && isValidImageUpload();

      allow delete: if
        isOwner(ownerId);

      allow read: if
        signedIn();
    }


    /* =========================================================
       PRODUCTS — PRODUCT IMAGES

       products/{workerId}/{fileName}

       Used by uploadProductImage()
    ========================================================= */

    match /products/{workerId}/{fileName} {

      /*
       * Only the authenticated worker who owns
       * the product folder can upload.
       */
      allow create: if
        isOwner(workerId)
        && isValidImageUpload();

      /*
       * Only the owner can replace the image.
       */
      allow update: if
        isOwner(workerId)
        && isValidImageUpload();

      /*
       * Only the owner can delete the image.
       */
      allow delete: if
        isOwner(workerId);

      /*
       * Signed-in users can view product images.
       */
      allow read: if
        signedIn();
    }


    /* =========================================================
       BOOKING PHOTOS

       bookings/{customerId}/{bookingId}/{fileName}
    ========================================================= */

    match /bookings/{customerId}/{bookingId}/{fileName} {

      /*
       * Customer can upload booking photos.
       */
      allow create: if
        isOwner(customerId)
        && isValidImageUpload();

      /*
       * Customer can replace booking photos.
       */
      allow update: if
        isOwner(customerId)
        && isValidImageUpload();

      /*
       * Customer can delete booking photos.
       */
      allow delete: if
        isOwner(customerId);

      /*
       * Customer can read their own photos.
       *
       * Worker can read photos when the booking
       * belongs to that worker.
       */
      allow read: if
        isOwner(customerId)
        ||
        (
          signedIn()
          &&
          firestore.exists(
            /databases/(default)/documents/bookings/$(bookingId)
          )
          &&
          firestore.get(
            /databases/(default)/documents/bookings/$(bookingId)
          ).data.workerId == request.auth.uid
        );
    }


    /* =========================================================
       SHOP REQUEST PHOTOS

       shop-requests/{customerId}/{requestId}/{fileName}
    ========================================================= */

    match /shop-requests/{customerId}/{requestId}/{fileName} {

      /*
       * Customer can upload request photos.
       */
      allow create: if
        isOwner(customerId)
        && isValidImageUpload();

      /*
       * Customer can replace request photos.
       */
      allow update: if
        isOwner(customerId)
        && isValidImageUpload();

      /*
       * Customer can delete request photos.
       */
      allow delete: if
        isOwner(customerId);

      /*
       * Customer can read their own photos.
       *
       * Worker can read photos when the request
       * belongs to that worker.
       */
      allow read: if
        isOwner(customerId)
        ||
        (
          signedIn()
          &&
          firestore.exists(
            /databases/(default)/documents/shopRequests/$(requestId)
          )
          &&
          firestore.get(
            /databases/(default)/documents/shopRequests/$(requestId)
          ).data.workerId == request.auth.uid
        );
    }


    /* =========================================================
       DEFAULT DENY

       Anything not explicitly allowed above is denied.
    ========================================================= */

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}