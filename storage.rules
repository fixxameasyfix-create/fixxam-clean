rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    /* ============================================================
       USER PROFILE PHOTO
       users/{uid}/profile/profile-photo.jpg
    ============================================================ */

    match /users/{uid}/profile/profile-photo.jpg {

      /* Public profile photo */
      allow read:
        if true;

      /* Only owner can upload/replace */
      allow create, update:
        if request.auth != null
        && request.auth.uid == uid
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches(
          'image/.*'
        );

      /* Only owner can delete */
      allow delete:
        if request.auth != null
        && request.auth.uid == uid;
    }


    /* ============================================================
       CUSTOMER PROFILE PHOTO
       customerProfiles/{uid}/profile.jpg
    ============================================================ */

    match /customerProfiles/{uid}/profile.jpg {

      /* Public customer profile photo */
      allow read:
        if true;

      /* Only owner can upload/replace */
      allow create, update:
        if request.auth != null
        && request.auth.uid == uid
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches(
          'image/.*'
        );

      /* Only owner can delete */
      allow delete:
        if request.auth != null
        && request.auth.uid == uid;
    }


    /* ============================================================
       WORKER PROFILE PHOTO
       workerProfiles/{uid}/profile.jpg
    ============================================================ */

    match /workerProfiles/{uid}/profile.jpg {

      /* Customers can display worker photos */
      allow read:
        if true;

      /* Only worker owner can upload/replace */
      allow create, update:
        if request.auth != null
        && request.auth.uid == uid
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches(
          'image/.*'
        );

      /* Only worker owner can delete */
      allow delete:
        if request.auth != null
        && request.auth.uid == uid;
    }


    /* ============================================================
       WORKER GALLERY
       workerProfiles/{uid}/gallery/{fileName}
    ============================================================ */

    match /workerProfiles/{uid}/gallery/{fileName} {

      /* Gallery images can be displayed publicly */
      allow read:
        if true;

      /* Only worker owner can upload/replace */
      allow create, update:
        if request.auth != null
        && request.auth.uid == uid
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches(
          'image/.*'
        );

      /* Only worker owner can delete */
      allow delete:
        if request.auth != null
        && request.auth.uid == uid;
    }


    /* ============================================================
       PRODUCT IMAGES
       products/{workerId}/{fileName}
    ============================================================ */

    match /products/{workerId}/{fileName} {

      /*
       * Product images are public because customers
       * must be able to browse marketplace products.
       */
      allow read:
        if true;

      /*
       * ONLY the authenticated worker who owns the
       * product folder can upload a product image.
       */
      allow create:
        if request.auth != null
        && request.auth.uid == workerId
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches(
          'image/.*'
        );

      /*
       * ONLY the product owner can replace
       * an existing product image.
       */
      allow update:
        if request.auth != null
        && request.auth.uid == workerId
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches(
          'image/.*'
        );

      /*
       * ONLY the product owner can delete
       * product images.
       */
      allow delete:
        if request.auth != null
        && request.auth.uid == workerId;
    }


    /* ============================================================
       BOOKING PHOTOS
       bookings/{customerId}/{fileName}
    ============================================================ */

    match /bookings/{customerId}/{fileName} {

      /*
       * Customer can read their own booking photos.
       */
      allow read:
        if request.auth != null
        && request.auth.uid == customerId;

      /*
       * Only the customer who owns the folder
       * can upload booking photos.
       */
      allow create:
        if request.auth != null
        && request.auth.uid == customerId
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches(
          'image/.*'
        );

      /*
       * Only the customer who owns the folder
       * can replace a booking photo.
       */
      allow update:
        if request.auth != null
        && request.auth.uid == customerId
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches(
          'image/.*'
        );

      /*
       * Only the customer can delete
       * their own booking photos.
       */
      allow delete:
        if request.auth != null
        && request.auth.uid == customerId;
    }


    /* ============================================================
       DEFAULT DENY
    ============================================================ */

    match /{allPaths=**} {

      /*
       * Anything not explicitly allowed above
       * is completely denied.
       */
      allow read, write:
        if false;
    }
  }
}